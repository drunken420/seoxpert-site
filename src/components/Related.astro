---
// Links to the other pages, with the words people search for as the link text.
interface Props { skip?: string }
const { skip = '' } = Astro.props;
const all = [
  { href: '/website-design/', title: 'Website design', text: 'New websites planned for Google and AI search before they are designed.' },
  { href: '/website-development/', title: 'Website development', text: 'How every website is coded for Google and AI search from the ground up.' },
  { href: '/website-maintenance/', title: 'Website maintenance', text: 'XpertCare: monthly care for websites we build, with high speed hosting included.' },
  { href: '/ai-website-builder/', title: 'AI website builder', text: 'How XpertCore, our own AI builder, plans, writes and marks up every page.' },
  { href: '/packages/', title: 'Website design packages', text: 'What every package includes, and what a website costs.' },
  { href: '/demos/', title: 'Interactive website demos', text: 'Live 3D and animation we can build into your website.' },
  { href: '/blog/', title: 'Website design and SEO guides', text: 'Plain guides on prices, SEO, AI SEO and website maintenance in Malaysia.' },
  { href: '/faq/', title: 'Website design questions', text: 'Short, plain answers about websites, Google and AI search.' },
  { href: '/about/', title: 'About our web design company', text: 'Founder led, selective and white hat only.' },
];
const items = all.filter((x) => x.href !== skip).slice(0, 4);
---
<section class="solid band related"><div class="wrap">
  <span class="eyebrow rv">Keep exploring</span>
  <h2 class="rv">More from SEOXpert.</h2>
  <div class="rgrid">
    {items.map((x, i) => <a class="rcard rv" style={`--d:${i}`} href={x.href}><h3>{x.title}</h3><p>{x.text}</p><span class="more">Read more</span></a>)}
  </div>
</div></section>
