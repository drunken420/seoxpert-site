---
// "Build your plan": pick a website (or keep your own) and an XpertRank plan, see the total, send it to us.
// Needs scripts, so it stays hidden until public/js/packages.js switches it on.
import { build, care, own, offer, offerOn, fmt, fmtYear, fmtNew, fmtYearNew, fmtOther, fmtYearOther, yearly, type Tier } from '../data/packages';
const on = offerOn();
// While the launch offer runs, each choice also shows its price from 1 February 2027, crossed out.
const later = (t: Tier, yr: boolean) => on ? { 'data-rm-n': fmtNew(t, 'RM'), 'data-usd-n': fmtNew(t, 'USD'), ...(yr ? { 'data-rm-y-n': fmtYearNew(t, 'RM'), 'data-usd-y-n': fmtYearNew(t, 'USD') } : {}) } : {};
import { site } from '../config';
// prices for a website built elsewhere, used when "I already have a website" is picked
const other = (t: Tier) => ({ 'data-rm-o': fmtOther(t, 'RM'), 'data-usd-o': fmtOther(t, 'USD'), 'data-rm-y-o': fmtYearOther(t, 'RM'), 'data-usd-y-o': fmtYearOther(t, 'USD') });
const data = (t: Tier) => ({ 'data-name': t.name, 'data-rm': fmt(t, 'RM'), 'data-usd': fmt(t, 'USD'), 'data-rows': JSON.stringify(t.rows), 'data-free': offerOn() && t.free ? t.free : '' });
---
<div class="pkbuilder" id="planpicker" hidden data-offer-ends={on ? offer.ends : undefined} data-offer-text={on ? offer.endsText : undefined} data-wa={site.whatsapp} data-mail={site.email} data-all={JSON.stringify(build.all.slice(0, 3))}>
  <div>
    <div class="pkstep rv"><h3>1. Choose your website</h3><p>A one-time price to plan, write, design and launch.</p>
      <div class="pkpick" data-pick-set="build">
        {build.tiers.map((t, i) => <button type="button" aria-pressed={i === 1 ? 'true' : 'false'} data-i={i} {...data(t)} {...later(t, false)}><b>{t.name}</b><span data-rm={fmt(t, 'RM')} data-usd={fmt(t, 'USD')}>{fmt(t)}</span>{on && <i class="pkn">From 1 Feb 2027: <s><span data-rm={fmtNew(t, 'RM')} data-usd={fmtNew(t, 'USD')}>{fmtNew(t)}</span></s></i>}<small>{t.short}</small></button>)}
        <button type="button" class="pkown" aria-pressed="false" data-i={build.tiers.length} data-own="1" data-name={own.name} data-rm="No build" data-usd="No build" data-rows={JSON.stringify(own.rows)}><b>{own.name}</b><span>No build</span><small>{own.short}</small></button>
      </div>
      <p class="pkquote">Bigger website, an online shop or bookings? <a href="/contact/" data-track="get-a-quote">Get a quote</a></p>
    </div>
    <div class="pkstep rv"><h3>2. Add XpertRank, our expert SEO service</h3><p>Our SEO experts work on your website every month: new highly rankable content, keyword tracking, fixes and AI search optimisation, so it keeps climbing on Google and in AI answers. <a class="pkmbchip" href="#promise">Backed by our money-back promise</a> Websites we build get the lower price and free high speed cloud hosting, and the XpertRank plan can be as big as the website. Already have a website? XpertRank works on it too, at its own price.</p>
      <div class="pkseg pkbill" role="group" aria-label="How to pay" data-pk-bill><button type="button" aria-pressed="true" data-b="month">Pay monthly</button><button type="button" aria-pressed="false" data-b="year">Pay yearly <em>{yearly.text}</em></button></div>
      <div class="pkpick four" data-pick-set="care">
        <button type="button" aria-pressed="false" data-i="-1"><b>No SEO plan</b><span data-rm="RM0" data-usd="$0">RM0</span><small>I will do my own SEO</small></button>
        {care.tiers.map((t, i) => <button type="button" aria-pressed={i === 1 ? 'true' : 'false'} data-i={i} {...data(t)} data-rm-y={fmtYear(t, 'RM')} data-usd-y={fmtYear(t, 'USD')} {...later(t, true)} {...other(t)}><b>{t.name}</b><span data-rm={fmt(t, 'RM')} data-usd={fmt(t, 'USD')} data-rm-y={fmtYear(t, 'RM')} data-usd-y={fmtYear(t, 'USD')} {...other(t)}>{fmt(t)}</span>{on && <i class="pkn">From 1 Feb 2027: <s><span data-rm={fmtNew(t, 'RM')} data-usd={fmtNew(t, 'USD')} data-rm-y={fmtYearNew(t, 'RM')} data-usd-y={fmtYearNew(t, 'USD')}>{fmtNew(t)}</span></s></i>}<small>{t.short}</small>{i > 0 && <em hidden>Needs {build.tiers[Math.min(i, build.tiers.length - 1)].name}{i < 2 ? ' or Growth' : ''}</em>}</button>)}
      </div>
    </div>
  </div>
  <div class="pksum rv" role="status" aria-live="polite"><h3>Your plan</h3>
    <div class="row"><span data-sum="bn"></span><b data-sum="bp"></b></div>
    <div class="row"><span data-sum="cn"></span><b data-sum="cp"></b></div>
    <p class="pklater" data-sum="later" hidden></p>
    <ul class="pktick" data-sum="list"></ul>
    <a class="btn" href="/contact/" data-sum="send">Send this plan</a>
    <!-- Money-back promise seal (Suhen 2026-11-15, a gold shield since the same day): it sways in 3D with CSS only, no extra script. Exact promise words only. -->
    <div class="pkmb" id="promise">
      <div class="mbshield" aria-hidden="true"><Fragment set:html={`<svg class="mbsvg" viewBox="0 0 120 140" aria-hidden="true"><defs><linearGradient id="mbgp" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#fff1b8"/><stop offset=".35" stop-color="#f2b632"/><stop offset=".7" stop-color="#c88910"/><stop offset="1" stop-color="#ffd970"/></linearGradient><linearGradient id="mbep" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#4b0f8a"/><stop offset="1" stop-color="#1c0336"/></linearGradient></defs><path d="M60 8C72 2 92 2 108 9v44c0 40-26 64-48 79C38 117 12 93 12 53V9c16-7 36-7 48-1z" fill="url(#mbgp)"/><path d="M60 18c10-5 26-5 38 1v35c0 33-21 52-38 64-17-12-38-31-38-64V19c12-6 28-6 38-1z" fill="url(#mbep)"/><path d="M60 22c9-4 23-4 34 1v31c0 30-19 48-34 59-15-11-34-29-34-59V23c11-5 25-5 34-1z" fill="none" stroke="#f2b632" stroke-width="1.2" opacity=".8"/><path d="m42 52 12 12 25-25" fill="none" stroke="url(#mbgp)" stroke-width="8" stroke-linecap="round" stroke-linejoin="round"/><text x="60" y="92" text-anchor="middle" fill="url(#mbgp)" font-family="Sora,Arial Black,Arial,sans-serif" font-weight="800" font-size="20">100%</text></svg>`} /></div>
      <div><p class="mbtag">Money-back promise</p><p class="mbtext">If none of your tracked keywords reaches Google's top 50 in your first month, we refund that month of XpertRank in full.</p><p class="mbnote">Every paid XpertRank plan. Not the Trial.</p></div>
    </div>
  </div>
</div>
