---
// "Build your plan": pick a website and a care plan, see the total, send it to us.
// Needs scripts, so it stays hidden until public/js/packages.js switches it on.
import { build, care, offer, offerOn, fmt, fmtYear, fmtNew, fmtYearNew, yearly, type Tier } from '../data/packages';
const on = offerOn();
// While the launch offer runs, each choice also shows its price from 1 February 2027, crossed out.
const later = (t: Tier, yr: boolean) => on ? { 'data-rm-n': fmtNew(t, 'RM'), 'data-usd-n': fmtNew(t, 'USD'), ...(yr ? { 'data-rm-y-n': fmtYearNew(t, 'RM'), 'data-usd-y-n': fmtYearNew(t, 'USD') } : {}) } : {};
import { site } from '../config';
const data = (t: Tier) => ({ 'data-name': t.name, 'data-rm': fmt(t, 'RM'), 'data-usd': fmt(t, 'USD'), 'data-rows': JSON.stringify(t.rows), 'data-free': offerOn() && t.free ? t.free : '' });
---
<div class="pkbuilder" id="planpicker" hidden data-offer-ends={on ? offer.ends : undefined} data-offer-text={on ? offer.endsText : undefined} data-wa={site.whatsapp} data-mail={site.email} data-all={JSON.stringify(build.all.slice(0, 3))}>
  <div>
    <div class="pkstep rv"><h3>1. Choose your website</h3><p>A one-time price to plan, write, design and launch.</p>
      <div class="pkpick" data-pick-set="build">
        {build.tiers.map((t, i) => <button type="button" aria-pressed={i === 1 ? 'true' : 'false'} data-i={i} {...data(t)} {...later(t, false)}><b>{t.name}</b><span data-rm={fmt(t, 'RM')} data-usd={fmt(t, 'USD')}>{fmt(t)}</span>{on && <i class="pkn">From 1 Feb 2027: <s><span data-rm={fmtNew(t, 'RM')} data-usd={fmtNew(t, 'USD')}>{fmtNew(t)}</span></s></i>}<small>{t.short}</small></button>)}
      </div>
    </div>
    <div class="pkstep rv"><h3>2. Add an XpertCare plan</h3><p>Optional. Only for websites we build, with high speed hosting included. Your care plan can be as big as your website, not bigger.</p>
      <div class="pkseg pkbill" role="group" aria-label="How to pay" data-pk-bill><button type="button" aria-pressed="true" data-b="month">Pay monthly</button><button type="button" aria-pressed="false" data-b="year">Pay yearly <em>{yearly.text}</em></button></div>
      <div class="pkpick four" data-pick-set="care">
        <button type="button" aria-pressed="false" data-i="-1"><b>No care</b><span data-rm="RM0" data-usd="$0">RM0</span><small>I will look after it myself</small></button>
        {care.tiers.map((t, i) => <button type="button" aria-pressed={i === 1 ? 'true' : 'false'} data-i={i} {...data(t)} data-rm-y={fmtYear(t, 'RM')} data-usd-y={fmtYear(t, 'USD')} {...later(t, true)}><b>{t.name}</b><span data-rm={fmt(t, 'RM')} data-usd={fmt(t, 'USD')} data-rm-y={fmtYear(t, 'RM')} data-usd-y={fmtYear(t, 'USD')}>{fmt(t)}</span>{on && <i class="pkn">From 1 Feb 2027: <s><span data-rm={fmtNew(t, 'RM')} data-usd={fmtNew(t, 'USD')} data-rm-y={fmtYearNew(t, 'RM')} data-usd-y={fmtYearNew(t, 'USD')}>{fmtNew(t)}</span></s></i>}<small>{t.short}</small>{i > 0 && <em hidden>Needs {build.tiers[i].name}{i < 2 ? ' or Growth' : ''}</em>}</button>)}
      </div>
    </div>
  </div>
  <div class="pksum rv" role="status" aria-live="polite"><h3>Your plan</h3>
    <div class="row"><span data-sum="bn"></span><b data-sum="bp"></b></div>
    <div class="row"><span data-sum="cn"></span><b data-sum="cp"></b></div>
    <p class="pklater" data-sum="later" hidden></p>
    <ul class="pktick" data-sum="list"></ul>
    <a class="btn" href="/contact/" data-sum="send">Send this plan</a>
    <p class="pknote">Nothing is ordered yet. This sends us your choice so we can talk it through.</p>
  </div>
</div>
