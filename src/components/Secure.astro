---
// "Secure by design" (Suhen 2026-11-17: "sell our website building service as super secure well made", "add new layers in pages if needed").
// Every line here must stay TRUE for every XpertForge website: static pages, no database, no admin login, HTTPS,
// the safety headers in public/_headers, our cloud hosting's built-in DDoS protection, Stripe's own payment page,
// the code history that keeps every version. Never write "unhackable", "100% secure" or any number we did not measure.
// The picture is drawn in SVG and moved by CSS only (styles `.sec*` in site.css): no script, no extra download.
// Hovering or focusing a layer in the list lights up the same plate (`:has()` in site.css).
interface Props { compact?: boolean; id?: string; light?: boolean }
const { compact = false, id = 'secure', light = false } = Astro.props;

// Plates from the bottom up. Number 0 is the website itself, on top.
const layers = [
  { n: 4, t: 'A global cloud network', d: 'Pages are sent from a network of servers near your visitors, with built-in protection against floods of fake traffic (DDoS) that try to knock a website offline.' },
  { n: 3, t: 'HTTPS on every page', d: 'The padlock on every page, renewed for you, and browsers are told to always use the secure address.' },
  { n: 2, t: 'Safety headers', d: 'Instructions sent with every page that stop other websites showing yours inside theirs to trick visitors, and block the camera, microphone and location your website never needs.' },
  { n: 1, t: 'Nothing to break into', d: 'Your website is ready-made pages with no database and no admin login. There is no password to guess and no plugin to fall out of date.' },
];
const shown = [...layers].reverse(); // the list reads from the inside out: 1, 2, 3, 4

// Isometric plate: centre x, centre y, half width, half height, thickness.
const W = 118, H = 59, T = 9, CX = 160;
const top = (y: number) => `M${CX} ${y - H}L${CX + W} ${y}L${CX} ${y + H}L${CX - W} ${y}Z`;
const left = (y: number) => `M${CX - W} ${y}L${CX} ${y + H}V${y + H + T}L${CX - W} ${y + T}Z`;
const right = (y: number) => `M${CX + W} ${y}L${CX} ${y + H}V${y + H + T}L${CX + W} ${y + T}Z`;
const ys = [292, 236, 180, 124]; // layers 4, 3, 2, 1
const webY = 62;
---
<section id={id} class:list={['secz band', light ? 'solid' : 'dark']}><div class="wrap">
  <div class="secgrid">
    <div class="sectext">
      <span class="eyebrow rv">Secure by design</span>
      {compact
        ? <h2 class="rv">Built secure, layer by layer.</h2>
        : <h2 class="rv">Secure by design, one layer at a time.</h2>}
      <p class="sub rv">Every XpertForge website is built as ready-made pages with no database and no admin login, then sent over HTTPS from a global cloud network with built-in DDoS protection. There is very little to attack, and four layers guard the rest.</p>
      {compact && <a class="btn rv" href="/website-development/#secure" data-track="secure-more">See how we secure every website</a>}
    </div>

    <figure class="secfig rv" aria-hidden="true">
      <svg class="secsvg" viewBox="0 0 320 380" role="presentation">
        <defs>
          <linearGradient id={`${id}-pg`} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#c79bff" /><stop offset="1" stop-color="#7B18C1" /></linearGradient>
          <linearGradient id={`${id}-pw`} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#ffffff" /><stop offset="1" stop-color="#efe3ff" /></linearGradient>
          <radialGradient id={`${id}-glow`}><stop offset="0" stop-color="#b06cff" stop-opacity=".55" /><stop offset="1" stop-color="#b06cff" stop-opacity="0" /></radialGradient>
        </defs>
        <ellipse class="secglow" cx={CX} cy="300" rx="150" ry="60" fill={`url(#${id}-glow)`} />
        {layers.map((l, i) => (
          <g class={`sl sl${l.n}`} style={`--i:${i};--c:${Math.round((180 - ys[i]) * .55)}px`}>
            <path class="slr" d={right(ys[i])} />
            <path class="sll" d={left(ys[i])} />
            <path class="slt" d={top(ys[i])} />
            <path class="sle" d={top(ys[i])} />
            <g class="sln" transform={`translate(${CX + W - 34} ${ys[i] + 15})`}>
              <circle r="11" /><text y="4.5" text-anchor="middle">{l.n}</text>
            </g>
          </g>
        ))}
        <g class="sl slw" style={`--i:4;--c:${Math.round((180 - webY) * .55)}px`}>
          <path class="slr" d={right(webY)} />
          <path class="sll" d={left(webY)} />
          <path class="slt" d={top(webY)} fill={`url(#${id}-pw)`} />
          <g transform={`translate(${CX} ${webY}) matrix(.82 .41 -.82 .41 0 0)`}>
            <rect x="-56" y="-50" width="112" height="14" rx="5" class="slbar" />
            <rect x="-56" y="-28" width="70" height="8" rx="4" class="slln" />
            <rect x="-56" y="-14" width="96" height="8" rx="4" class="slln" />
            <rect x="-56" y="0" width="84" height="8" rx="4" class="slln" />
            <rect x="-56" y="18" width="40" height="30" rx="6" class="slbox" />
            <rect x="-10" y="18" width="40" height="30" rx="6" class="slbox" />
          </g>
          <g class="sllock" transform={`translate(${CX} ${webY - 66})`}>
            <path class="slsh" d="M0 -26 L22 -18 V-2 C22 13 12 22 0 26 C-12 22 -22 13 -22 -2 V-18 Z" />
            <rect x="-8" y="-4" width="16" height="13" rx="3" />
            <path d="M-5 -4 V-8 A5 5 0 0 1 5 -8 V-4" />
          </g>
        </g>
      </svg>
    </figure>

    <ol class="seclist">
      {shown.map((l, i) => (
        <li class="rv" data-l={l.n} tabindex="0" style={`--d:${i}`}><b>{l.n}</b><h3>{l.t}</h3><p>{l.d}</p></li>
      ))}
    </ol>
  </div>

  {!compact && (
    <div class="secmore">
      <div class="secx rv"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="6" width="18" height="13" rx="3" /><path d="M3 10.5h18M7 15h4" /></svg><h3>Payments and forms kept apart</h3><p>Card details are typed on Stripe's own secure payment page, never on your website. Contact forms have a hidden trap for spam robots and send an email, with nothing stored on the website.</p></div>
      <div class="secx rv" style="--d:1"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.4-5.7" /><path d="M4 4v4.5h4.5" /><path d="M12 8v4.5l3 2" /></svg><h3>Every version kept</h3><p>Every change is saved in the code history, so we can put an earlier version back quickly. Every build includes 30 days of free fixes after launch.</p></div>
      <div class="secx rv" style="--d:2"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12h4l2.5-6 5 12 2.5-6h4" /></svg><h3>Watched after launch</h3><p>With <a href="/website-maintenance/">XpertRank</a> we keep backups, watch uptime and check your website every few days, fixing what we find.</p></div>
    </div>
  )}
  {!compact && <p class="secnote rv"><b>Our honest note.</b> No website on the internet can truly be called impossible to hack, and we will never claim it. What we can do is leave as little as possible to attack, and keep watch.</p>}
</div></section>
