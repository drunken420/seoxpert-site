---
// Portfolio. Add a new piece to this list (and its screenshot to public/work/). Real work only.
const work = [
  { name: 'CosmolinkOS', url: 'https://cosmolinkos.com/', img: '/work/cosmolinkos.jpg', vid: '/work/cosmolinkos', alt: 'The CosmolinkOS homepage: a 3D pixel planet above the headline "AI crews that run your home lab, day and night"', kind: 'Product website', text: 'A website for CosmolinkOS, a self-hosted office of AI agent crews for home labs. We built the animated 3D homepage, the guides, the glossary and the waitlist.' },
  { name: 'XpertStocks', url: 'https://xpertstocks.com/', img: '/work/xpertstocks.jpg', vid: '/work/xpertstocks', alt: 'The XpertStocks homepage: a glowing purple 3D X mark inside rings of purple light beside the headline "Track Bursa Malaysia stocks with clear numbers."', kind: 'Our own web app', text: 'Our own free Bursa Malaysia stock tools: calculators for trading fees, position size, dividends and EPF, a paper trading simulator, guides and a glossary, all built as fast static pages. A stock tracking dashboard is coming soon with a waitlist; until then the site is tools and education only.' },
];
---
<div class="work">
  {work.map((w) => (
    <article class="workcard rv">
      <a class="workshot" data-vid={w.vid} href={w.url} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true"><span class="workbar"><i></i><i></i><i></i><b>{w.url.replace(/^https:\/\/|\/$/g, '')}</b></span><img src={w.img} alt={`${w.alt}. A website designed and built by SEOXpert.`} width="1280" height="853" loading="lazy" decoding="async"></a>
      <div class="workinfo"><span class="eyebrow">{w.kind}</span><h3>{w.name}</h3><p>{w.text}</p><a class="more" href={w.url} target="_blank" rel="noopener">Visit {w.url.replace(/^https:\/\/|\/$/g, '')}<span class="vh"> (opens in a new tab)</span></a></div>
    </article>
  ))}
</div>
