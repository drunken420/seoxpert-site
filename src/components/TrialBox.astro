---
// The XpertRank Trial box: under the care cards (Packages.astro) and on its own on the SEO audit page.
import { trial, fmt, terms, type Tier } from '../data/packages';
import { site } from '../config';
const price = (t: Tier) => ({ 'data-rm': fmt(t, 'RM'), 'data-usd': fmt(t, 'USD') });
---
<div class="pktrial rv">
  <div><span class="pktag">New</span><h3>{trial.name}</h3>
    {/* What the Trial includes as short ticks instead of a long sentence (Suhen 2026-11-16 polish); the last row is what it leaves out. */}
    <ul class="pktrows">{trial.rows.map((r, i) => <li class:list={[i === trial.rows.length - 1 && 'no']} set:html={r} />)}</ul>
    <p>{terms.trial} Choose a paid XpertRank plan after your trial and the trial price comes off your first month.</p></div>
  <div class="pktside">
    <p class="pktprice"><span {...price(trial)}>{fmt(trial)}</span><small>for {trial.days} days</small></p>
    {site.payments && <a class="btn payon-only" href="/contact/?need=trial" data-pay="trial" data-track="pay-trial"><span>Pay <span {...price(trial)}>{fmt(trial)}</span> and start</span></a>}
    <a class:list={['btn', site.payments && 'payoff-only']} href="/contact/?need=trial" data-track="start-trial">Start your trial</a>
    {/* A quiet trust line (Suhen 2026-11-16: "remove it unless it's a good thing, then enhance it"): lock, Stripe, the ways to pay. */}
    {site.payments && <p class="pktpay payon-only"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="10.5" width="14" height="10" rx="2.5"/><path d="M8.5 10.5V8a3.5 3.5 0 0 1 7 0v2.5"/></svg><span>Secure checkout by Stripe</span><span class="pkways"><i>Card</i><i>FPX</i><i>GrabPay</i></span></p>}
  </div>
</div>
