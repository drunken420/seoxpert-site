---
// Package cards (website build and XpertRank), the RM or USD switch and the launch offer.
// show="both" adds the Build / XpertRank switch; show="care" shows the care plans only.
import { build, care, trial, offer, offerOn, fmt, fmtYear, fmtNew, fmtYearNew, fmtOther, yearly, type Tier } from '../data/packages';
import { site } from '../config';
interface Props { show?: 'both' | 'care'; pickHref?: string }
const { show = 'both', pickHref = '/packages/#plan' } = Astro.props;
const sets = show === 'care' ? [care] : [build, care];
const on = offerOn();
const price = (t: Tier) => ({ 'data-rm': fmt(t, 'RM'), 'data-usd': fmt(t, 'USD') });
---
<div class="pk" data-pk>
  {show !== 'care' && <div class="pkbar rv">
    {show === 'both' && (
      <div class="pkseg" role="group" aria-label="Package type" data-pk-kind hidden>
        <button type="button" aria-pressed="true" data-k="build">XpertForge build</button>
        <button type="button" aria-pressed="false" data-k="care">XpertRank SEO</button>
      </div>
    )}
    <div class="pkcur" hidden data-pk-curbar><span>Show prices in</span>
      <div class="pkseg sm" role="group" aria-label="Currency" data-pk-cur>
        <button type="button" aria-pressed="true" data-c="RM">RM</button>
        <button type="button" aria-pressed="false" data-c="USD">USD</button>
      </div>
    </div>
  </div>}
  {on && (
    <div class="pkoffer rv" data-pk-offer={offer.ends}>
      <i class="pkoshine" aria-hidden="true"></i><i class="pkopet" aria-hidden="true" style="--x:72%;--y:14%;--s:34px;--t:7s"></i><i class="pkopet" aria-hidden="true" style="--x:93%;--y:62%;--s:54px;--t:9s"></i><i class="pkopet" aria-hidden="true" style="--x:58%;--y:78%;--s:22px;--t:6s"></i>
      <div class="pkotop"><span class="pkotag">Launch offer</span><span class="pkoleft" data-pk-left hidden></span></div>
      <p class="pkotitle">{offer.title}</p>
      <p class="pkoend">XpertRank is included in this launch offer. Each package below shows how many free months you get. Order before {offer.endsText}.</p>
    </div>
  )}
  {sets.map((S) => (
    <div class="pkset" data-set={S.key}>
      {show === 'both' && <h3 class="pksetname">{S.label}</h3>}
      {S.key === 'care' && (
        <div class="pkwhy rv">
          <p class="pkwhyh"><span class="xp sm">XpertRank</span> What you get that most SEO services don't</p>
          <ul>
            <li><b>Your own live dashboard</b><span>XpertInsight puts visitors, leads, Google searches, speed, uptime, and your domain and SSL renewal dates in one place, refreshed every day.</span></li>
            <li><b>Seen by AI, not just Google</b><span>We check whether ChatGPT, Gemini, Perplexity and Google's AI answers mention you, every month.</span></li>
            <li><b>Keyword positions every week</b><span>See exactly where you rank on Google for the words your customers search.</span></li>
            <li><b>New highly rankable content</b><span>Blog posts written with XpertCore, our AI core, and checked by experts, every month.</span></li>
            <li><b>Checked every few days</b><span>We find problems and fix them, plus SEO and AI search optimisation when needed.</span></li>
            <li><b>Money-back promise</b><span>On websites we build: if none of your tracked keywords reaches Google's top 50 in your first month, we refund that month of XpertRank in full.</span></li>
          </ul>
        </div>
      )}
      {/* On the care-only pages the currency switch sits beside Pay monthly / Pay yearly (Suhen 2026-11-15). */}
      {S.key === 'care' && <div class="pkbillrow rv"><div class="pkseg pkbill" role="group" aria-label="How to pay" data-pk-bill hidden><button type="button" aria-pressed="true" data-b="month">Pay monthly</button><button type="button" aria-pressed="false" data-b="year">Pay yearly <em>{yearly.text}</em></button></div>
        {show === 'care' && <div class="pkcur" hidden data-pk-curbar><span>Show prices in</span><div class="pkseg sm" role="group" aria-label="Currency" data-pk-cur><button type="button" aria-pressed="true" data-c="RM">RM</button><button type="button" aria-pressed="false" data-c="USD">USD</button></div></div>}</div>}
      <div class={'pkcards' + (S.tiers.length === 4 ? ' n4' : '')}>
        {S.tiers.map((t, i) => (
          // Every card has the same rows (empty ones where a card has no "up" line or gift), so headings, prices, lists,
          // gifts and buttons line up across the row (CSS subgrid; Suhen 2026-11-15 "tidy it up").
          <article class={'pkcard rv' + (t.hot ? ' hot' : '')} style={`--d:${i};--rows:${4 + (on ? 1 : 0) + (S.key === 'care' ? 2 : 0) + (S.tiers.some((x) => x.up) ? 1 : 0) + 1 + (on && S.tiers.some((x) => x.free) ? 1 : 0)}`}>
            {t.hot && <span class="pkbadge">Recommended</span>}
            <h3>{t.name}</h3>
            <p class="pkfor">{t.for}</p>
            <p class="pkprice"><span {...price(t)} {...(S.key === 'care' ? { 'data-rm-y': fmtYear(t, 'RM'), 'data-usd-y': fmtYear(t, 'USD') } : {})}>{fmt(t)}</span>{S.unit && <small data-unit={S.key === 'care' ? '' : undefined}>{S.unit}</small>}</p>
            {on && <p class="pkwas" data-pk-offer={offer.ends}>{S.key === 'care' ? 'Launch price for our first 20 XpertRank clients.' : 'Launch price.'} From 1 February 2027: <s><span data-rm={fmtNew(t, 'RM')} data-usd={fmtNew(t, 'USD')} {...(S.key === 'care' ? { 'data-rm-y': fmtYearNew(t, 'RM'), 'data-usd-y': fmtYearNew(t, 'USD') } : {})}>{fmtNew(t)}</span></s></p>}
            {S.key === 'care' && <p class="pkyear"><span class="m">or <span data-rm={fmtYear(t, 'RM')} data-usd={fmtYear(t, 'USD')}>{fmtYear(t)}</span> a year, {yearly.text}</span><span class="y">12 months for the price of {yearly.pay}</span></p>}
            {S.key === 'care' && <a class="pkmbadge" href="#money-back" data-track="promise-chip"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2 4 5v6c0 5 3.4 9.3 8 11 4.6-1.7 8-6 8-11V5z"/><path d="m8.5 12 2.5 2.5 4.5-5"/></svg><span>Money-back promise on our builds</span></a>}
            {t.up ? <p class="pkup">{t.up}</p> : t.start ? <p class="pkup pkstart">{t.start}</p> : S.tiers.some((x) => x.up) && <p class="pkup0" aria-hidden="true"></p>}
            <ul class="pktick">{t.rows.map((r) => <li set:html={r} />)}{(t.locked || []).map((r) => <li class="lk"><span class="sro">Not in this plan: </span>{r}</li>)}</ul>
            {on && t.free ? <p class="pkgift" data-pk-offer={offer.ends}>Launch offer: {t.free}</p> : on && S.tiers.some((x) => x.free) && <p class="pkup0" aria-hidden="true"></p>}
            <a class="btn" href={pickHref} data-pick={`${S.key}:${i}`}>Choose {t.name}</a>
          </article>
        ))}
      </div>
      {S.key === 'care' && (
        <div class="pktrial rv">
          <div><span class="pktag">New</span><h3>{trial.name}</h3><p>{trial.short}.</p></div>
          <div class="pktside">
            <p class="pktprice"><span {...price(trial)}>{fmt(trial)}</span><small>for {trial.days} days</small></p>
            {site.payments && <a class="btn payon-only" href="/contact/?need=trial" data-pay="trial" data-track="pay-trial"><span>Pay <span {...price(trial)}>{fmt(trial)}</span> and start</span></a>}
            <a class:list={['btn', site.payments && 'payoff-only']} href="/contact/?need=trial" data-track="start-trial">Start your trial</a>
            {site.payments && <p class="pktpay payon-only">Secure payment by Stripe</p>}
          </div>
        </div>
      )}
      {S.key === 'care' && (
        <div class="pkpromise rv" id="money-back"><span class="pkptag">Money-back promise</span><p><b>If none of your tracked keywords reaches Google's top 50 in your first month, we refund that month of XpertRank in full.</b> It covers every paid XpertRank plan, Basic, Plus, Pro and Elite, on websites we build. Websites built elsewhere and the 14-day Trial are not covered, because we need at least a month to work on your website and help it rank. We check your website every day, and you can see every keyword position in your XpertInsight dashboard.</p></div>
      )}
      {S.key === 'care' && (
        <div class="pkxi rv">
          <div class="pkxitext">
            <span class="pkxitag">Included with every XpertRank plan</span>
            <h3>Your own <span class="xp">XpertInsight</span> dashboard account</h3>
            <p>Every XpertRank plan comes with your own login to XpertInsight, our live website report dashboard. No extra fee.</p>
            <ul>
              <li>Live data from Google (visitors, leads, searches, speed and uptime), refreshed every day</li>
              <li>Your keyword positions on Google, checked every week</li>
              <li>Whether ChatGPT, Gemini and other AI tools mention your business</li>
              <li>Site health checks and what our team fixed</li>
              <li>Domain name and SSL certificate renewal dates, with reminders</li>
              <li>A monthly XpertRecap PDF report</li>
              <li>Works on your phone too</li>
            </ul>
            <a class="more" href="/website-report-dashboard/">See the XpertInsight dashboard</a>
          </div>
          <div class="pkxiimg"><img src="/img/xi-screen-overview-720.webp" srcset="/img/xi-screen-overview-720.webp 720w, /img/xi-screen-overview.webp 1440w" sizes="(max-width:900px) 92vw, 520px" width="1440" height="900" loading="lazy" decoding="async" alt="The XpertInsight dashboard overview, showing visitors, keyword positions and site health for the Sample Bakery" /></div>
        </div>
      )}
      {S.key === 'care' && <p class="pknote rv">Prices are for websites we build with <span class="xp sm">XpertForge</span>, with free high speed cloud hosting. Already have a website? <span class="xp sm">XpertRank</span> works on it too, from {fmtOther(care.tiers[0])} a month, without hosting. <a href="#plan" data-pick="build:3">See your price</a></p>}
      <div class="pkall rv"><h3>{S.allTitle}</h3><ul>{S.all.map((a) => <li>{a}</li>)}</ul></div>
    </div>
  ))}
</div>
