---
// Package cards (website build and XpertCare), the RM or USD switch and the launch offer.
// show="both" adds the Build / XpertCare switch; show="care" shows the care plans only.
import { build, care, offer, offerOn, fmt, fmtYear, fmtNew, fmtYearNew, yearly, type Tier } from '../data/packages';
interface Props { show?: 'both' | 'care'; pickHref?: string }
const { show = 'both', pickHref = '/packages/#plan' } = Astro.props;
const sets = show === 'care' ? [care] : [build, care];
const on = offerOn();
const price = (t: Tier) => ({ 'data-rm': fmt(t, 'RM'), 'data-usd': fmt(t, 'USD') });
---
<div class="pk" data-pk>
  <div class="pkbar rv">
    {show === 'both' && (
      <div class="pkseg" role="group" aria-label="Package type" data-pk-kind hidden>
        <button type="button" aria-pressed="true" data-k="build">XpertForge build</button>
        <button type="button" aria-pressed="false" data-k="care">XpertCare monthly</button>
      </div>
    )}
    <div class="pkcur" hidden data-pk-curbar><span>Show prices in</span>
      <div class="pkseg sm" role="group" aria-label="Currency" data-pk-cur>
        <button type="button" aria-pressed="true" data-c="RM">RM</button>
        <button type="button" aria-pressed="false" data-c="USD">USD</button>
      </div>
    </div>
  </div>
  {on && (
    <div class="pkoffer rv" data-pk-offer={offer.ends}>
      <i class="pkoshine" aria-hidden="true"></i><i class="pkopet" aria-hidden="true" style="--x:72%;--y:14%;--s:34px;--t:7s"></i><i class="pkopet" aria-hidden="true" style="--x:93%;--y:62%;--s:54px;--t:9s"></i><i class="pkopet" aria-hidden="true" style="--x:58%;--y:78%;--s:22px;--t:6s"></i>
      <div class="pkotop"><span class="pkotag">Launch offer</span><span class="pkoleft" data-pk-left hidden></span></div>
      <p class="pkotitle">{offer.title}</p>
      <ul class="pkolist">{build.tiers.filter((t) => t.free).map((t) => <li><b>{t.name.replace('XpertForge ', '')}</b>{t.free}</li>)}</ul>
      <p class="pkoend">Order before {offer.endsText}.</p>
    </div>
  )}
  {sets.map((S) => (
    <div class="pkset" data-set={S.key}>
      {show === 'both' && <h3 class="pksetname">{S.label}</h3>}
      {S.key === 'care' && <div class="pkseg pkbill rv" role="group" aria-label="How to pay" data-pk-bill hidden><button type="button" aria-pressed="true" data-b="month">Pay monthly</button><button type="button" aria-pressed="false" data-b="year">Pay yearly <em>{yearly.text}</em></button></div>}
      <div class="pkcards">
        {S.tiers.map((t, i) => (
          <article class={'pkcard rv' + (t.hot ? ' hot' : '')} style={`--d:${i}`}>
            {t.hot && <span class="pkbadge">Recommended</span>}
            <h3>{t.name}</h3>
            <p class="pkfor">{t.for}</p>
            <p class="pkprice"><span {...price(t)} {...(S.key === 'care' ? { 'data-rm-y': fmtYear(t, 'RM'), 'data-usd-y': fmtYear(t, 'USD') } : {})}>{fmt(t)}</span><small data-unit={S.key === 'care' ? '' : undefined}>{S.unit}</small></p>
            {on && <p class="pkwas" data-pk-offer={offer.ends}>Launch price. From 1 February 2027: <s><span data-rm={fmtNew(t, 'RM')} data-usd={fmtNew(t, 'USD')} {...(S.key === 'care' ? { 'data-rm-y': fmtYearNew(t, 'RM'), 'data-usd-y': fmtYearNew(t, 'USD') } : {})}>{fmtNew(t)}</span></s></p>}
            {S.key === 'care' && <p class="pkyear"><span class="m">or <span data-rm={fmtYear(t, 'RM')} data-usd={fmtYear(t, 'USD')}>{fmtYear(t)}</span> a year, {yearly.text}</span><span class="y">12 months for the price of {yearly.pay}</span></p>}
            <ul class="pktick">{t.rows.map((r) => <li set:html={r} />)}</ul>
            {on && t.free && <p class="pkgift" data-pk-offer={offer.ends}>Launch offer: {t.free}</p>}
            <a class="btn" href={pickHref} data-pick={`${S.key}:${i}`}>Choose {t.name}</a>
          </article>
        ))}
      </div>
      {S.key === 'care' && <p class="pknote rv"><span class="xp sm">XpertCare</span> is only for websites we build with XpertForge. High speed hosting is included.</p>}
      <div class="pkall rv"><h3>{S.allTitle}</h3><ul>{S.all.map((a) => <li>{a}</li>)}</ul></div>
    </div>
  ))}
</div>
