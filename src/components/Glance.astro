---
// "At a glance" picture for a page: a real <img> with descriptive alt text (words and file names in src/data/pictures.json,
// pictures made by scripts/make-pics.cjs). Pass the page key, for example <Glance page="website-design" />.
import pictures from '../data/pictures.json';
import { posts, postUrl } from '../data/blog';
// guides = slugs of blog guides to link under the picture
interface Props { page: keyof typeof pictures; tint?: boolean; guides?: string[] }
const { page, tint = false, guides = [] } = Astro.props;
const read = guides.map((g) => posts.find((x) => x.slug === g)).filter(Boolean);
const p = pictures[page];
---
<section class={`solid band glance${tint ? ' tint' : ''}`}><div class="wrap">
  <span class="eyebrow rv">At a glance</span>
  <h2 class="rv">{p.title}.</h2>
  <figure class="pfig rv">
    <img src={`/img/${p.file}.webp`} srcset={`/img/${p.file}-640.webp 640w, /img/${p.file}-900.webp 900w, /img/${p.file}.webp 1200w`} sizes="(max-width: 900px) 100vw, 860px" width="1200" height="630" alt={p.alt} loading="lazy" decoding="async">
    <figcaption>{p.alt}</figcaption>
  </figure>
  {read.length > 0 && <p class="gread rv"><b>Read next:</b> {read.map((g, i) => <>{i > 0 && ', '}<a href={postUrl(g!)}>{g!.h1}</a></>)}</p>}
</div></section>
