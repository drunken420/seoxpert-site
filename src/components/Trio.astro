---
// The three product names side by side: XpertForge builds it, XpertCore (our AI SEO advisor) guides it, XpertRank grows it.
// Styles: "product trio" at the end of src/styles/site.css.
interface Props { skip?: string }
const { skip } = Astro.props;
const items = [
  { name: 'XpertForge', role: 'The website build', text: 'A new website at one price, paid once. Pick Starter, Business or Growth.', href: '/packages/', more: 'See packages and prices' },
  { name: 'XpertCore', role: 'Our AI core', text: 'Our team uses it to plan your pages, write answer first copy and add the setup Google and AI need.', href: '/ai-seo-advisor/', more: 'How our AI SEO advisor works' },
  { name: 'XpertRank', role: 'SEO, AI search and care', text: 'Monthly SEO and AI search optimisation with live data, backups and fixes, with free high speed cloud hosting for the websites we build.', href: '/website-maintenance/', more: 'Our website maintenance services' },
];
---
<section class="solid tint band trio"><div class="wrap">
  <span class="eyebrow rv">Three names to know</span>
  <h2 class="rv">Built with XpertForge, guided by XpertCore, grown by XpertRank.</h2>
  <p class="sub rv">We built all three ourselves, in house. Every website follows the same path: XpertForge builds it, XpertCore guides what we plan and write, and XpertRank keeps growing it.</p>
  <ol class="trio3">
    {items.map((it, i) => (
      <li class={'rv' + (i === 1 ? ' mid' : '')} style={`--d:${i}`}>
        <b class="n" aria-hidden="true">{'0' + (i + 1)}</b>
        <span class="xp">{it.name}</span>
        <h3>{it.role}</h3>
        <p>{it.text}</p>
        {it.href !== skip && <a class="more" href={it.href}>{it.more}</a>}
      </li>
    ))}
  </ol>
</div></section>
