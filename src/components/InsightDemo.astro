---
// A live, coded copy of XpertInsight, our client dashboard (styles: src/styles/insight.css, script: public/js/insight.js).
// Every name and number here belongs to the made-up "Sample Bakery" from the dashboard's own sample data. Suhen (2026-11-12): no "sample" notes or captions; the name Sample Bakery is the only label.
import { care } from '../data/packages';
const plus = care.tiers[1];
const num = (r: string) => Number(r.match(/<b>(\d+)<\/b>/)?.[1] || 0);
const [chg, posts, kws] = plus.rows.map(num);
const ico: Record<string, string> = {
  Overview: 'M4 4h7v7H4zM13 4h7v4h-7zM13 10h7v10h-7zM4 13h7v7H4z',
  Visitors: 'M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM2 21a7 7 0 0 1 14 0M16 3.5a4 4 0 0 1 0 7M18 14a6 6 0 0 1 4 7',
  Leads: 'M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12Z',
  Keywords: 'M11 18a7 7 0 1 0 0-14 7 7 0 0 0 0 14zM21 21l-5-5',
  'AI answers': 'M12 3l2 6 6 2-6 2-2 6-2-6-6-2 6-2zM19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8z',
  'Site health': 'M3 12h4l3-7 4 14 3-7h4',
  'Care plan': 'M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z',
  Reports: 'M7 3h7l5 5v13H7zM14 3v5h5M10 13h6M10 17h6',
};
const views = Object.keys(ico);
const spark = (pts: number[], w = 120, h = 34) => { const mx = Math.max(...pts), mn = Math.min(...pts); return pts.map((p, i) => `${(i / (pts.length - 1) * w).toFixed(1)},${(h - 3 - (p - mn) / (mx - mn || 1) * (h - 6)).toFixed(1)}`).join(' '); };
const now = [38, 52, 46, 61, 55, 70, 58, 66, 74, 63, 79, 71, 68, 82];
const before = [34, 41, 44, 49, 47, 52, 50, 55, 58, 54, 60, 57, 59, 62];
const line = (pts: number[]) => pts.map((p, i) => `${(i / (pts.length - 1) * 600).toFixed(0)},${(200 - p * 2).toFixed(0)}`).join(' ');
const uptime = Array.from({ length: 30 }, (_, i) => (i === 13 ? 'w' : ''));
---
<div class="xistack rv">
<div class="xi" data-insight>
  <div class="xibar"><i></i><i></i><i></i><span>insight.seoxpert.my</span></div>
  <div class="xigrid">
    <div class="xinav" role="tablist" aria-label="XpertInsight views">
      <span class="xilogo">Xpert<em>Insight</em></span>
      {views.map((v, i) => <button type="button" role="tab" id={`xit${i}`} aria-controls={`xiv${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}><svg viewBox="0 0 24 24" aria-hidden="true"><path d={ico[v]} /></svg>{v}</button>)}
      <span class="xipdf">Download PDF</span>
    </div>
    <div class="ximain">
      <div class="xihead"><b>Sample Bakery</b><span><i></i>Live</span><em>28 days</em></div>

      <section class="xiv on" id="xiv0" role="tabpanel" aria-labelledby="xit0">
        <div class="xihero" style="--n:0">
          <div class="xiring"><svg viewBox="0 0 100 100" aria-hidden="true"><circle cx="50" cy="50" r="42"/><circle class="v" cx="50" cy="50" r="42" pathLength="100" style="--p:79"/></svg><b data-n="79">79</b><small>Xpert score</small></div>
          <div><h4>Your website is growing well</h4><p>1,629 people visited and 58 of them got in touch. 4 of 10 keywords are on Google's first page.</p>
            <div class="xibars dk">{[['Visits', 88], ['Leads', 84], ['Rankings', 72], ['AI mentions', 60], ['Health', 92]].map(([k, v]) => <span><em>{k}</em><b>{v}</b><i style={`--w:${v}%`}></i></span>)}</div></div>
        </div>
        <div class="xik">
          <div style="--n:1"><small>Visitors</small><b data-n="1629">1,629</b><em>▲ 10% vs before</em><svg viewBox="0 0 120 34" aria-hidden="true"><polyline points={spark([5, 8, 6, 9, 7, 11, 9, 12])} /></svg></div>
          <div style="--n:2"><small>Leads</small><b data-n="58">58</b><em>▲ 21% vs before</em><svg viewBox="0 0 120 34" aria-hidden="true"><polyline points={spark([4, 6, 5, 7, 9, 8, 10, 11])} /></svg></div>
          <div style="--n:3"><small>AI visits</small><b data-n="54">54</b><em>▲ 4 vs before</em><svg viewBox="0 0 120 34" aria-hidden="true"><polyline points={spark([2, 3, 3, 5, 4, 6, 7, 8])} /></svg></div>
        </div>
        <div class="xicard xiwin" style="--n:4"><span class="xitag">Win</span><b>"Birthday cake delivery" reached page 1</b><p>It moved from position 13 to 9 after we rewrote the page to answer price and delivery questions first.</p></div>
      </section>

      <section class="xiv" id="xiv1" role="tabpanel" aria-labelledby="xit1" hidden>
        <div class="xicard" style="--n:0"><b>Visitors by day</b><p class="xilegend"><i></i>This period <i class="b"></i>Period before</p>
          <svg class="xichart" viewBox="0 0 600 200" preserveAspectRatio="none" aria-hidden="true"><polyline class="b" points={line(before)} /><polyline points={line(now)} /></svg></div>
        <div class="xi2">
          <div class="xicard" style="--n:1"><b>Where visitors came from</b><div class="xibars">{[['Search', 46], ['Direct', 27], ['Social', 16], ['Other', 7], ['AI tools', 3]].map(([k, v]) => <span><em>{k}</em><b>{v}%</b><i style={`--w:${v}%`}></i></span>)}</div></div>
          <div class="xicard" style="--n:2"><b>Phone or computer</b><div class="xidonut"><svg viewBox="0 0 42 42" aria-hidden="true"><circle cx="21" cy="21" r="15.9"/><circle class="v" cx="21" cy="21" r="15.9" pathLength="100" style="--p:74"/></svg><span><b data-n="74">74</b>%<small>on phones</small></span></div></div>
        </div>
      </section>

      <section class="xiv" id="xiv2" role="tabpanel" aria-labelledby="xit2" hidden>
        <div class="xik">
          <div style="--n:0"><small>WhatsApp</small><b data-n="33">33</b><em>clicks</em></div>
          <div style="--n:1"><small>Form messages</small><b data-n="22">22</b><em>sent</em></div>
          <div style="--n:2"><small>Call clicks</small><b data-n="3">3</b><em>taps</em></div>
        </div>
        <div class="xi2">
          <div class="xicard" style="--n:3"><b>Leads by week</b><div class="xicols">{[17, 13, 16, 12].map((v, i) => <span style={`--h:${v * 5}%`}><b>{v}</b><em>Week {i + 1}</em></span>)}</div></div>
          <div class="xicard" style="--n:4"><b>Pages that bring leads</b><div class="xibars">{[['Custom cakes', 18], ['Homepage', 14], ['Birthday cakes', 10], ['Contact', 6]].map(([k, v]) => <span><em>{k}</em><b>{v}</b><i style={`--w:${Number(v) * 5}%`}></i></span>)}</div></div>
        </div>
      </section>

      <section class="xiv" id="xiv3" role="tabpanel" aria-labelledby="xit3" hidden>
        <div class="xicard" style="--n:0"><b>Tracked keywords, checked every week</b>
          <div class="xitable">{[['birthday cake delivery', 9, '▲ 4', true], ['wedding cake price', 7, '–', true], ['cupcake order online', 5, '▲ 3', true], ['custom cakes', 12, '▲ 2', false], ['eggless cake', 14, '▲ 5', false]].map(([k, p, c, one]) => <span><em>{k}</em>{one ? <i class="xip ok">Page 1</i> : <i class="xip al">Almost</i>}<b>{p}</b><small>{c}</small></span>)}</div></div>
        <div class="xicard" style="--n:1"><b>You vs competitors</b><div class="xibars">{[['You', 4], ['Competitor A', 6], ['Competitor B', 3]].map(([k, v]) => <span><em>{k}</em><b>{v} of 10</b><i style={`--w:${Number(v) * 10}%`}></i></span>)}</div></div>
      </section>

      <section class="xiv" id="xiv4" role="tabpanel" aria-labelledby="xit4" hidden>
        <div class="xicard" style="--n:0"><b>Do AI tools name you?</b><p class="xinote">"Best birthday cake delivery", asked this month</p>
          <div class="xiai">{[['ChatGPT', true], ['Gemini', false], ['Perplexity', false], ['AI Overviews', true]].map(([k, y], i) => <span style={`--n:${i + 1}`}><em>{k}</em><i class={y ? 'xip ok' : 'xip no'}>{y ? 'Named' : 'Not yet'}</i></span>)}</div></div>
        <div class="xi2">
          <div class="xicard" style="--n:2"><b>Visits sent by AI tools</b><div class="xibars">{[['ChatGPT', 14], ['Perplexity', 5], ['Gemini', 3], ['Copilot', 1]].map(([k, v]) => <span><em>{k}</em><b>{v}</b><i style={`--w:${Number(v) * 6}%`}></i></span>)}</div></div>
          <div class="xicard xibig" style="--n:3"><b data-n="3">3</b><span>of 20 answers name you</span><em>▲ 2 vs last month</em></div>
        </div>
      </section>

      <section class="xiv" id="xiv5" role="tabpanel" aria-labelledby="xit5" hidden>
        <div class="xi2">
          <div class="xicard xihealth" style="--n:0"><div class="xiring sm"><svg viewBox="0 0 100 100" aria-hidden="true"><circle cx="50" cy="50" r="42"/><circle class="v" cx="50" cy="50" r="42" pathLength="100" style="--p:92"/></svg><b data-n="92">92</b></div>
            <ul class="xichecks"><li>Pages working: all 12</li><li>Broken links: 3 found, 3 fixed</li><li>Security certificate: valid</li><li>Pages on Google: 11 of 12</li></ul></div>
          <div class="xicard" style="--n:1"><b>Speed on phones</b><div class="xibars">{[['Loading', '1.6 s', 84], ['Response to taps', '90 ms', 92], ['Layout shift', '0.02', 96]].map(([k, v, w]) => <span><em>{k}</em><b>{v}</b><i style={`--w:${w}%`}></i></span>)}</div></div>
        </div>
        <div class="xicard" style="--n:2"><b>Uptime, last 30 days: 99.98%</b><div class="xiup">{uptime.map((u) => <i class={u} />)}</div></div>
      </section>

      <section class="xiv" id="xiv6" role="tabpanel" aria-labelledby="xit6" hidden>
        <div class="xi2">
          <div class="xicard" style="--n:0"><b>{plus.name}, this month</b><div class="xibars">{[['Website changes', 4, chg], ['Blog posts', 2, posts], ['Tracked keywords', 10, kws]].map(([k, v, of]) => <span><em>{k}</em><b>{v} of {of}</b><i style={`--w:${Number(v) / Number(of) * 100}%`}></i></span>)}</div></div>
          <div class="xicard" style="--n:1"><b>Done this month</b><ul class="xichecks"><li>Fixed 3 broken links</li><li>New blog post: eggless cakes guide</li><li>Custom cakes page now answers price questions first</li></ul></div>
        </div>
        <div class="xicard" style="--n:2"><b>Coming next</b><ul class="xinext"><li>Get the last page onto Google</li><li>A clearer Google title for the menu page</li><li>A delivery FAQ that AI tools can quote</li></ul></div>
      </section>

      <section class="xiv" id="xiv7" role="tabpanel" aria-labelledby="xit7" hidden>
        <div class="xi2">
          <div class="xipages" style="--n:0" aria-hidden="true">{['Overview', 'Visitors', 'Leads', 'Keywords', 'AI answers', 'Care plan'].map((p, i) => <div style={`--i:${i}`}><b>XpertRecap</b><em>{p}</em><i></i><i></i><i class="s"></i></div>)}</div>
          <div class="xicard" style="--n:1"><b>XpertRecap, your monthly PDF</b><p>Six pages: the overview, visitors, leads, keywords, AI answers with site health, and your care plan: what we did and what comes next.</p><span class="xipdf in">Download PDF</span></div>
        </div>
      </section>
    </div>
  </div>
</div>
</div>
