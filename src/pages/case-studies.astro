---
// SEO case studies (Suhen asked 2026-11-15): live results from websites we built.
// REAL NUMBERS ONLY. Every number here comes from a screenshot Suhen posted (Google Search Console)
// or from the XpertInsight dashboard (Google Analytics), with the dates they cover. Never round up,
// never invent. Client websites are added only with the client's permission.
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Cta from '../components/Cta.astro';
import Related from '../components/Related.astro';
import '../styles/page.css';
import '../styles/blog.css';
import { site, whatsappLink, talkLabel } from '../config';
import { posts } from '../data/blog';

const updated = '2026-11-15';
// seoxpert.my, our own website. The new version went live on 11 November 2026.
const first = { range: '10 to 13 November 2026', impressions: 410, clicks: 5, searches: 84, position: '54.9' };
const day = { range: '1 PM on 14 November to 12 PM on 15 November 2026, Malaysia time', impressions: 237, clicks: 1, searches: 73, position: '55.7' };
const visits = { range: '11 to 14 November 2026', people: 29, computer: 59, phone: 41 };
// Top searches in the first days, from Search Console (impressions = times Google showed seoxpert.my).
const queries = [
  ['malaysia web design package', 53, 0], ['website maintenance malaysia', 32, 1], ['seo expert', 20, 0], ['wordpress website maintenance malaysia', 16, 0],
  ['web maintenance malaysia', 14, 0], ['web maintenance service', 12, 0], ['seo petaling jaya', 12, 0], ['website maintenance services', 10, 0],
  ['site maintenance services', 8, 1], ['seoxpert', 2, 2],
];
const guides = posts.length;
const url = `${site.url}/case-studies/`;
const extraLd = [{ '@type': 'Article', headline: 'SEO case study: seoxpert.my, the first days after launch', description: `Live Google results for seoxpert.my after launch: ${first.impressions} Google impressions from ${first.searches} different searches in the first days, and ${visits.people} visitors.`, url, mainEntityOfPage: url, datePublished: updated, dateModified: updated, inLanguage: 'en', author: { '@id': `${site.url}/#org` }, publisher: { '@id': `${site.url}/#org` }, about: { '@type': 'WebSite', name: 'SEOXpert', url: site.url }, image: { '@type': 'ImageObject', url: `${site.url}/work/gsc-seoxpert-first-days.jpg`, width: 1400, height: 936 } }];
---
<Base title="SEO Case Studies Malaysia: Live Results | SEOXpert" image="/work/gsc-seoxpert-first-days.jpg" description={`Live SEO results from a website we built, straight from Google. seoxpert.my was shown on Google ${first.impressions} times for ${first.searches} different searches in its first days.`} path="/case-studies/" crumb="Case studies" extraLd={extraLd}>
<main id="main">
<PageHero kicker="Case studies" brand="XpertRank" art="seo" crumb="Case studies" word="Results">
  <Fragment slot="title">Live SEO results, <em>from a real website</em>.</Fragment>
  <Fragment slot="lede">Our first case study is our own website, seoxpert.my, with real numbers straight from Google Search Console and Google Analytics. No made-up figures. We add client websites, with their permission, as their results come in.</Fragment>
  <Fragment slot="cta"><a class="btn" href="#seoxpert">See the first case study</a><a class="btn ghost" href="/seo-services-malaysia/">Our SEO services</a></Fragment>
</PageHero>

<section id="seoxpert" class="solid band"><div class="wrap">
  <span class="eyebrow rv">Case study 1: seoxpert.my</span>
  <h2 class="rv">Our own website, in its first days on Google.</h2>
  <p class="sub rv">We rebuilt seoxpert.my with XpertForge and XpertCore, the same way we build every client website, and the new version went live on 11 November 2026. Updated <time datetime={updated}>15 November 2026</time>.</p>
  <div class="cstats">
    <div class="cstat rv" style="--d:0"><b>{first.impressions}</b><span>times Google showed the website</span><small>{first.range}</small></div>
    <div class="cstat rv" style="--d:1"><b>{first.searches}</b><span>different Google searches it showed up for</span><small>{first.range}</small></div>
    <div class="cstat rv" style="--d:2"><b>{visits.people}</b><span>visitors</span><small>{visits.range}</small></div>
    <div class="cstat rv" style="--d:3"><b>{day.impressions}</b><span>times shown on Google in the last 24 hours</span><small>for {day.searches} different searches</small></div>
  </div>
</div></section>

<section class="solid tint band"><div class="wrap split">
  <div class="stick">
    <span class="eyebrow rv">From Google Search Console</span>
    <h2 class="rv">The searches we already show up for.</h2>
    <p class="sub rv">The top searches in the first days, {first.range}. Impressions are the times Google showed seoxpert.my in its results.</p>
  </div>
  <div>
    <div class="btable rv" tabindex="0" role="region" aria-label="Top Google searches for seoxpert.my in its first days"><table><thead><tr><th>Search</th><th>Impressions</th><th>Clicks</th></tr></thead><tbody>
      {queries.map((q) => <tr><td>{q[0]}</td><td>{q[1]}</td><td>{q[2]}</td></tr>)}
    </tbody></table></div>
    <p class="ctot rv"><button type="button" class="cinfo" aria-describedby="ctotal"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9.5"/><path d="M12 11v6M12 7.5v.01"/></svg>Totals and average position</button><span class="ctip" role="tooltip" id="ctotal">In total: <b>{first.clicks} clicks</b> from <b>{first.impressions} impressions</b>, at an average position of <b>{first.position}</b>. In the last 24 hours ({day.range}): {day.clicks} click from {day.impressions} impressions, at an average position of {day.position}.</span></p>
  </div>
</div></section>

<section class="solid band"><div class="wrap">
  <span class="eyebrow rv">The proof</span>
  <h2 class="rv">Straight from Google, not retyped.</h2>
  <div class="cshots">
    <figure class="rv"><img src="/work/gsc-seoxpert-first-days.webp" alt={`Google Search Console for seoxpert.my, ${first.range}: ${first.clicks} clicks, ${first.impressions} impressions, average position ${first.position}, with the top searches.`} width="1400" height="936" loading="lazy" decoding="async"><figcaption>Google Search Console, {first.range}.</figcaption></figure>
    <figure class="rv" style="--d:1"><img src="/work/gsc-seoxpert-24-hours.webp" alt={`Google Search Console for seoxpert.my, the last 24 hours: ${day.clicks} click, ${day.impressions} impressions, average position ${day.position}, with the top searches.`} width="1400" height="982" loading="lazy" decoding="async"><figcaption>Google Search Console, the last 24 hours.</figcaption></figure>
  </div>
  <figure class="cwide rv"><img src="/work/xi-seoxpert-visitors.webp" alt="Visitors by day for seoxpert.my in the XpertInsight dashboard, from Google Analytics: visitors start on 11 November 2026, the day the new website went live." width="1400" height="395" loading="lazy" decoding="async"><figcaption>Visitors by day in XpertInsight, our live dashboard, from Google Analytics. {visits.computer}% of visitors used a computer and {visits.phone}% a phone.</figcaption></figure>
</div></section>

<section class="solid tint band"><div class="wrap split">
  <div class="stick">
    <span class="eyebrow rv">What it means</span>
    <h2 class="rv">An honest reading of the numbers.</h2>
  </div>
  <div class="prose">
    <p class="rv">These are first results, a few days after launch. Google already shows the new website for {first.searches} different searches, including ones we planned for, such as "website maintenance malaysia" and "malaysia web design package".</p>
    <p class="rv">An average position of about 55 means the website is mostly on page 5 or 6 of Google for now. That is normal for a new website: Google tests new pages before it trusts them. Most websites begin to see results after eight to twelve weeks, so we will keep adding the numbers here every month, good or bad.</p>
    <p class="rv">Every page was planned with XpertCore: one clear topic per page, answer first writing, structured data, an AI ranking file for AI tools, and {guides} guides on <a href="/blog/">XpertAdvice</a>. It is the same work that goes into every <a href="/website-design/">website we design</a> and every <a href="/seo-services-malaysia/">XpertRank SEO plan</a>.</p>
  </div>
</div></section>

<section class="solid band"><div class="wrap">
  <div class="note rv"><h3>More case studies are coming</h3><p>As client websites go live, we will add their results here, with their permission. Want your website to be the next one? <a href={whatsappLink}>{talkLabel}</a>.</p></div>
</div></section>
<Related skip="/case-studies/" />
<Cta title="Want results like these for your business?" />
</main>
</Base>
