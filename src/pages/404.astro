---
import Base from '../layouts/Base.astro';
import '../styles/page.css';
---
<Base title="Page Not Found | SEOXpert Website Design" description="This page could not be found. Head back to the SEOXpert homepage to see our website design and website maintenance services." path="/404/" noindex>
<main id="main">
<section class="phero center band"><div class="wrap">
  <p class="big404" aria-hidden="true">404</p>
  <h1>This page could not be found.</h1>
  <p class="lede">The link may be old, or the page may have moved.</p>
  <div class="cta-row"><a class="btn" href="/">Back to the homepage</a><a class="btn ghost" href="/website-design/">Website design</a></div>
</div></section>
</main>
</Base>
