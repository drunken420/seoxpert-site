---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Cta from '../components/Cta.astro';
import Related from '../components/Related.astro';
import Suite from '../components/Suite.astro';
import Glance from '../components/Glance.astro';
import PageFaq from '../components/PageFaq.astro';
import { pageFaq } from '../lib/faq';
import pictures from '../data/pictures.json';
import '../styles/page.css';
import Work from '../components/Work.astro';
import { build, fmt, px, buyer } from '../data/packages';
import { site, whatsappLink, talkLabel, areaText, areaLd } from '../config';
const extraLd = [{ '@type': 'Service', name: 'Website design', serviceType: 'Website design and building', provider: { '@id': `${site.url}/#org` }, url: `${site.url}/website-design/`, areaServed: areaLd, description: 'Website design for businesses in Malaysia, planned for Google and AI search before it is designed, guided by XpertCore, our own AI SEO advisor, and finished by hand.' }];
const pf = pageFaq(['How does a website project start?', 'How long does a website take?', 'How much does a website cost?', 'Is the domain name included?', 'Is copywriting included?', 'Can I change text or photos after launch?', 'Can you redesign my current website?', 'Which areas do you work in?']);
---
<Base title="Website Design Malaysia for Google and AI Search | SEOXpert" image={`/img/${pictures["website-design"].file}.jpg`} description="Website design in Malaysia for businesses that want to be found. Planned for Google and AI search first, guided by our own AI SEO advisor and finished by hand." path="/website-design/" crumb="Website design" extraLd={[...extraLd, pf.ld]}>
<main id="main">
<PageHero kicker="Website design" brand="XpertForge" art="design" crumb="Website design" word="Design">
  <Fragment slot="title">Website design in Malaysia, <em>built to be found</em>.</Fragment>
  <Fragment slot="lede">SEOXpert designs websites for businesses in Malaysia from <Fragment set:html={px(build.tiers[0])} />, with copywriting and keyword research included. Every page is planned for Google and AI search before it is designed.</Fragment>
  <Fragment slot="cta"><a class="btn" href={whatsappLink}>{talkLabel}</a><a class="btn ghost" href="#how">See how it works</a></Fragment>
</PageHero>

<section class="solid band"><div class="wrap">
  <span class="eyebrow rv">What you get</span>
  <h2 class="rv">A website that people, Google and AI all understand.</h2>
  <p class="sub rv">SEOXpert is a website design company for businesses in {areaText}. Our website design services cover the plan, the words, the look and the code. Good website design is more than a nice layout. With XpertForge, our website build, it is a clear answer to what you do, who it is for and how to reach you.</p>
  <div class="grid3">
    <div class="fcard rv" style="--d:0"><div class="pet" style="--r:0deg"></div><h3>Clear pages</h3><p>One clear topic per page, so a visitor knows what you do within a few seconds.</p></div>
    <div class="fcard rv" style="--d:1"><div class="pet" style="--r:90deg"></div><h3>Answer first writing</h3><p>Short, plain answers at the top of each page, written for what people are actually asking.</p></div>
    <div class="fcard rv" style="--d:2"><div class="pet" style="--r:180deg"></div><h3>Fast on phones</h3><p>Light pages that load quickly, because most people will meet your business on a phone.</p></div>
    <div class="fcard rv" style="--d:0"><div class="pet" style="--r:270deg"></div><h3>Ready for Google</h3><p>Well ordered headings, titles and descriptions, plus structured data that tells search engines the facts. See how our <a href="/website-development/">website development</a> builds it into the code.</p></div>
    <div class="fcard rv" style="--d:1"><div class="pet" style="--r:45deg"></div><h3>Ready for AI search</h3><p>Clear facts and quotable answers, with an AI ranking file that sums up your business for AI tools. See <a href="/ai-seo-advisor/">how our AI SEO advisor works</a>.</p></div>
    <div class="fcard rv" style="--d:2"><div class="pet" style="--r:135deg"></div><h3>Checked by experts</h3><p>XpertCore, our own AI SEO advisor, guides the work. Our experts check and refine every page before it goes live.</p></div>
  </div>
</div></section>

<section id="how" class="solid tint band"><div class="wrap split">
  <div class="stick">
    <span class="eyebrow rv">How it works</span>
    <h2 class="rv">From a conversation to a finished website.</h2>
    <p class="sub rv">Four steps. You always know which one we are on. XpertForge {buyer.times}, {buyer.from}.</p>
  </div>
  <div>
  <ol class="nsteps">
    <li class="rv"><h3>Tell us about your business</h3><p>Tell us a little about your business and what you would love your website to do. After you order, we email you within one working day, then a short call or a simple form gives us your details: your business information, your logo and photos (or we use good stock photos).</p></li>
    <li class="rv" style="--d:1"><h3>We plan the pages</h3><p><a href="/ai-seo-advisor/">XpertCore, our AI SEO advisor</a>, drafts the page plan, headings and answer first copy, with search in mind from the first line.</p></li>
    <li class="rv" style="--d:2"><h3>We design and refine by hand</h3><p>We shape the design around your brand, then check every page for clarity, accuracy and speed. You check your first draft, and we refine it in your revision rounds ({buyer.rounds}). {buyer.revision}</p></li>
    <li class="rv" style="--d:3"><h3>Launch, then look after it</h3><p>Your website goes live with the Google and AI setup in place, with {buyer.fixes}. <a href="/seo-services-malaysia/">XpertRank, our expert SEO service,</a> keeps it healthy and growing after that, and our team makes your changes. Without XpertRank, we hand your website over with a simple editing dashboard, on the hosting you choose.</p></li>
  </ol>
  <p class="sub rv" style="margin-top:22px">{buyer.bigger} The domain name is not included: you buy it in your own name with our help, or we buy it for you and transfer it to you. <a href="/packages/#after-pay">See what happens after you pay</a>.</p>
  </div>
</div></section>

<section id="packages" class="solid band"><div class="wrap">
  <span class="eyebrow rv">Packages</span>
  <h2 class="rv">How much does website design cost in Malaysia?</h2>
  <p class="sub rv">Our <a href="/packages/">website design packages</a> start at <Fragment set:html={px(build.tiers[0])} />, one time, with copywriting and keyword research included.</p>
  <div class="grid3">
    {build.tiers.map((t, i) => <div class="fcard rv" style={`--d:${i}`}><h3>{t.name}</h3><p><b set:html={px(t)} />. {t.short} at launch.</p></div>)}
  </div>
  <div class="pkall rv" style="margin-top:30px"><h3>Included with every website we build</h3><ul>{build.all.map((x) => <li>{x}</li>)}</ul></div>
  <p class="sub rv" style="margin-top:28px"><a href="/packages/">Compare the packages and build your plan</a>. After launch, our <a href="/website-maintenance/">website maintenance</a> plan, XpertRank, keeps your new website growing on Google and in <a href="/ai-seo-services-malaysia/">AI search</a>, and your <a href="/website-report-dashboard/">XpertInsight dashboard</a>, free with every XpertRank plan, shows the results live.</p>
</div></section>

<section id="work" class="solid tint band"><div class="wrap">
  <span class="eyebrow rv">Our work</span>
  <h2 class="rv">Website design we have built.</h2>
  <p class="sub rv">Need a dashboard, a login area or online payments too? See the web apps we have built on our <a href="/web-app-development-malaysia/">web app development</a> page.</p>
  <Work />
</div></section>
<Suite here="forge" title="What comes after your new website?" eyebrow="Build it, then grow it" intro="XpertForge builds your website. After launch, XpertRank, our expert SEO service, keeps growing it on Google and AI search, and XpertInsight shows you the results live. Would rather do your own SEO? That is XpertForesight." />
<Glance page="website-design" guides={['website-design-price-malaysia', 'website-design-kuala-lumpur-selangor', 'choose-web-design-company-malaysia']} />
<PageFaq title="Website design questions, answered." items={pf.items} tint />
<Related skip="/website-design/" />
<Cta title="Ready for a website that gets found?" />
</main>
</Base>
