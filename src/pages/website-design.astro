---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Cta from '../components/Cta.astro';
import Related from '../components/Related.astro';
import Glance from '../components/Glance.astro';
import pictures from '../data/pictures.json';
import '../styles/page.css';
import Work from '../components/Work.astro';
import { build, fmt } from '../data/packages';
import { site, whatsappLink, talkLabel, areaText, areaLd } from '../config';
const extraLd = [{ '@type': 'Service', name: 'Website design', serviceType: 'Website design and building', provider: { '@id': `${site.url}/#org` }, url: `${site.url}/website-design/`, areaServed: areaLd, description: 'Website design for businesses in Malaysia, planned for Google and AI search before it is designed, built with our own AI website builder and finished by hand.' }];
---
<Base title="Website Design Malaysia for Google and AI Search | SEOXpert" image={`/img/${pictures["website-design"].file}.jpg`} description="Website design in Malaysia for businesses that want to be found. Planned for Google and AI search first, built with our own AI website builder and finished by hand." path="/website-design/" crumb="Website design" extraLd={extraLd}>
<main id="main">
<PageHero kicker="Website design" brand="XpertForge" art="design" crumb="Website design" word="Design">
  <Fragment slot="title">Website design in Malaysia, <em>built to be found</em>.</Fragment>
  <Fragment slot="lede">Most websites are designed first and fixed for search later. We do it the other way round: every page is planned for Google and AI search before it is designed.</Fragment>
  <Fragment slot="cta"><a class="btn" href={whatsappLink}>{talkLabel}</a><a class="btn ghost" href="#how">See how it works</a></Fragment>
</PageHero>

<section class="solid band"><div class="wrap">
  <span class="eyebrow rv">What you get</span>
  <h2 class="rv">A website that people, Google and AI all understand.</h2>
  <p class="sub rv">We design websites for businesses in {areaText}. Good website design is more than a nice layout. With XpertForge, our website build, it is a clear answer to what you do, who it is for and how to reach you.</p>
  <div class="grid3">
    <div class="fcard rv" style="--d:0"><div class="pet" style="--r:0deg"></div><h3>Clear pages</h3><p>One clear topic per page, so a visitor knows what you do within a few seconds.</p></div>
    <div class="fcard rv" style="--d:1"><div class="pet" style="--r:90deg"></div><h3>Answer first writing</h3><p>Short, plain answers at the top of each page, written for what people are actually asking.</p></div>
    <div class="fcard rv" style="--d:2"><div class="pet" style="--r:180deg"></div><h3>Fast on phones</h3><p>Light pages that load quickly, because most people will meet your business on a phone.</p></div>
    <div class="fcard rv" style="--d:0"><div class="pet" style="--r:270deg"></div><h3>Ready for Google</h3><p>Well ordered headings, titles and descriptions, plus structured data that tells search engines the facts. See how our <a href="/website-development/">website development</a> builds it into the code.</p></div>
    <div class="fcard rv" style="--d:1"><div class="pet" style="--r:45deg"></div><h3>Ready for AI search</h3><p>Clear facts and quotable answers, with an llms.txt file that sums up your business for AI tools. See <a href="/ai-website-builder/">how our AI website builder works</a>.</p></div>
    <div class="fcard rv" style="--d:2"><div class="pet" style="--r:135deg"></div><h3>Checked by experts</h3><p>XpertCore, our AI builder, does the heavy lifting. Our experts check and refine every page before it goes live.</p></div>
  </div>
</div></section>

<section id="how" class="solid tint band"><div class="wrap split">
  <div class="stick">
    <span class="eyebrow rv">How it works</span>
    <h2 class="rv">From a conversation to a finished website.</h2>
    <p class="sub rv">Four steps. You always know which one we are on.</p>
  </div>
  <ol class="nsteps">
    <li class="rv"><h3>Tell us about your business</h3><p>Tell us a little about your business and what you would love your website to do. A short, friendly chat is all it takes to begin.</p></li>
    <li class="rv" style="--d:1"><h3>We plan the pages</h3><p><a href="/ai-website-builder/">XpertCore, our AI website builder</a>, drafts the page plan, headings and answer first copy, with search in mind from the first line.</p></li>
    <li class="rv" style="--d:2"><h3>We design and refine by hand</h3><p>We shape the design around your brand, then check every page for clarity, accuracy and speed.</p></li>
    <li class="rv" style="--d:3"><h3>Launch, then look after it</h3><p>Your website goes live with the Google and AI setup in place. <a href="/website-maintenance/">XpertCare monthly care</a> keeps it healthy after that.</p></li>
  </ol>
</div></section>

<section id="packages" class="solid band"><div class="wrap">
  <span class="eyebrow rv">Packages</span>
  <h2 class="rv">Website design packages.</h2>
  <p class="sub rv">How much does website design cost? Our <a href="/packages/">website design packages</a> start at RM499, one time, with copywriting and keyword research included.</p>
  <div class="grid3">
    {build.tiers.map((t, i) => <div class="fcard rv" style={`--d:${i}`}><h3>{t.name}</h3><p><b>{fmt(t)}</b> once. {t.short} at launch.</p></div>)}
  </div>
  <p class="sub rv" style="margin-top:28px"><a href="/packages/">Compare the packages and build your plan</a>.</p>
</div></section>

<section id="work" class="solid tint band"><div class="wrap">
  <span class="eyebrow rv">Our work</span>
  <h2 class="rv">Website design we have built.</h2>
  <Work />
</div></section>
<Glance page="website-design" guides={['website-design-price-malaysia', 'website-design-kuala-lumpur-selangor', 'choose-web-design-company-malaysia']} />
<Related skip="/website-design/" />
<Cta title="Ready for a website that gets found?" />
</main>
</Base>
