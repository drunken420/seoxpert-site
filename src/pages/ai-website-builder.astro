---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Cta from '../components/Cta.astro';
import Trio from '../components/Trio.astro';
import Related from '../components/Related.astro';
import '../styles/page.css';
import { whatsappLink, talkLabel } from '../config';
---
<Base title="AI Website Builder With SEO Built In | SEOXpert" description="Our own AI website builder plans the pages, writes answer first copy and adds the setup Google and AI search need. Then a real person checks every page." path="/ai-website-builder/" crumb="AI website builder">
<main id="main">
<PageHero kicker="Our AI builder" brand="XpertCore" art="core" crumb="AI website builder">
  <Fragment slot="title">An AI website builder with <em>search built in</em>.</Fragment>
  <Fragment slot="lede">XpertCore, our own AI website builder, lays the groundwork that Google and AI tools read. Then a real person checks and refines every page.</Fragment>
  <Fragment slot="cta"><a class="btn" href={whatsappLink}>{talkLabel}</a><a class="btn ghost" href="/website-design/">See website design</a></Fragment>
</PageHero>

<section class="solid band"><div class="wrap split">
  <div class="stick">
    <span class="eyebrow rv">What it does</span>
    <h2 class="rv">Every page, planned for search before it is designed.</h2>
    <p class="sub rv">Most AI website builders make a page that looks finished. Ours starts with what people and search engines need to understand.</p>
    <p class="sub rv">We call it XpertCore, and our team uses it for you. You tell us about your business, we build your website with XpertCore, and a real person checks every page. There is no tool for you to learn.</p>
  </div>
  <ol class="nsteps">
    <li class="rv"><h3>Plans the pages</h3><p>One clear topic per page, so nothing competes with itself and every page has a job.</p></li>
    <li class="rv" style="--d:1"><h3>Writes answer first</h3><p>Short, quotable answers at the top of each page, the way <a href="/faq/">AI search answers people</a>.</p></li>
    <li class="rv" style="--d:2"><h3>Marks it up</h3><p>Structured data (schema) so search engines and AI tools know the facts about your business.</p></li>
    <li class="rv" style="--d:3"><h3>Briefs the AI tools</h3><p>An llms.txt file that sums up your business in plain text for AI assistants.</p></li>
    <li class="rv" style="--d:4"><h3>Hands over to a person</h3><p>We check every page for accuracy, clarity and speed as part of our <a href="/website-design/">website design</a> work.</p></li>
  </ol>
</div></section>

<section class="dark band"><div class="wrap split">
  <div>
    <span class="eyebrow rv">What search engines see</span>
    <h2 class="rv">Clear facts, not guesswork.</h2>
    <p class="sub rv">This is the kind of groundwork the builder prepares for each website. The names here are examples only.</p>
  </div>
  <pre class="codecard rv" aria-label="Example of an llms.txt file"><span class="c"># llms.txt (example)</span>
<span class="k"># Your Business</span>
<span class="v">&gt; What you do, who it is for and how to reach you, in one plain sentence.</span>

<span class="k">## Services</span>
- Service one: a short, clear answer
- Service two: a short, clear answer

<span class="k">## Questions</span>
- The questions your customers really ask</pre>
</div></section>

<section class="solid band"><div class="wrap">
  <span class="eyebrow rv">Why not do it yourself?</span>
  <h2 class="rv">A tool is only half of a website.</h2>
  <div class="grid3">
    <div class="fcard rv"><div class="pet"></div><h3>Judgement</h3><p>A person decides what your business should say first, and what to leave out.</p></div>
    <div class="fcard rv" style="--d:1"><div class="pet" style="--r:90deg"></div><h3>Accuracy</h3><p>Every fact on your website is checked, because AI can sound right and still be wrong.</p></div>
    <div class="fcard rv" style="--d:2"><div class="pet" style="--r:180deg"></div><h3>Care after launch</h3><p><a href="/website-maintenance/">Website maintenance</a> keeps your pages updated, backed up and growing.</p></div>
  </div>
</div></section>
<Trio skip="/ai-website-builder/" />
<Related skip="/ai-website-builder/" />
<Cta title="Want to see what our builder would plan for you?" />
</main>
</Base>
