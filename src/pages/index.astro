---
import Base from '../layouts/Base.astro';
import '../styles/home.css';
import top from '../fragments/home-top.html?raw';
import lower from '../fragments/home-lower.html?raw';
import { site, whatsappLink } from '../config';
import Cta from '../components/Cta.astro';
import Trio from '../components/Trio.astro';
import { homeFaqLd } from '../lib/faq';
import icon from '../fragments/icon.svg?raw';
const fill = (h: string) => h.replace('<canvas id="gl" aria-hidden="true"></canvas>', '<canvas id="gl" aria-hidden="true"></canvas><div class="poster" aria-hidden="true">' + icon + '<i></i><i></i><i></i><i></i><i></i><i></i></div>').replace('<a href="#talk">WhatsApp us</a>, <a href="/contact/">email us</a>', site.whatsapp ? `<a href="${whatsappLink}">WhatsApp us</a>, <a href="/contact/">email us</a>` : '<a href="/contact/">Email us</a>');
const extraLd = [homeFaqLd];
---
<Base title="Website Design Malaysia: Built for Google and AI | SEOXpert" extraLd={extraLd}>
  <main id="main">
  <Fragment set:html={fill(top)} />
  <Trio />
  <Fragment set:html={lower} />
  <Cta />
  </main>
  <script slot="scripts" is:inline>
  /* The 3D scene is extra: the page is complete without it.
     Big screens: load it when the browser is idle. Phones: load it at the first touch or scroll, so the first paint stays fast. */
  (function () {
    var root = document.documentElement, started = false, list = ['/vendor/three-r128.min.js', '/js/sx.js', '/js/home.js'];
    function fail() { root.classList.add('no3d'); }
    function next() { var src = list.shift(); if (!src) { if (!root.classList.contains('no3d')) root.classList.add('gl-on'); return; } var s = document.createElement('script'); s.src = src; s.onload = next; s.onerror = fail; document.head.appendChild(s); }
    function go() { if (started) return; started = true; next(); }
    function idle() { (window.requestIdleCallback || function (f) { setTimeout(f, 300); })(go, { timeout: 2000 }); }
    ['pointerdown', 'keydown', 'touchstart', 'scroll', 'pointermove'].forEach(function (ev) { window.addEventListener(ev, go, { once: true, passive: true }); });
    if (window.matchMedia('(min-width: 901px) and (pointer: fine)').matches) { if (document.readyState === 'complete') idle(); else window.addEventListener('load', idle); }
  })();
  </script>
</Base>
