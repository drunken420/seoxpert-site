---
// SEO services in Malaysia (Suhen asked 2026-11-15): XpertRank sold as our expert SEO service.
// Keywords (Ubersuggest, Malaysia, 2026-11-15): seo services 2,400 a month, seo agency malaysia 2,400,
// seo malaysia 2,900, seo services malaysia 880, seo company malaysia 480.
// Rules: never promise rankings or page 1; the money-back promise is the one exception, in its exact words.
// XpertRank works on any website (Suhen 2026-11-15); websites we build (XpertForge) get the lower price and free high speed cloud hosting.
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Cta from '../components/Cta.astro';
import Related from '../components/Related.astro';
import Suite from '../components/Suite.astro';
import Glance from '../components/Glance.astro';
import PageFaq from '../components/PageFaq.astro';
import Packages from '../components/Packages.astro';
import pictures from '../data/pictures.json';
import '../styles/page.css';
import { site, whatsappLink, talkLabel, areaText, areaLd } from '../config';
import { care, fmt, fmtOther, px, offersLd, offerOn, rankNote } from '../data/packages';
import { pageFaq } from '../lib/faq';
const [basic, , , elite] = care.tiers;
const promise = "If none of your tracked keywords reaches Google's top 50 in your first month, we refund that month of XpertRank in full.";
const pf = pageFaq(['How much do SEO services cost in Malaysia?', 'What is the difference between the XpertRank plans?', 'Is XpertRank a subscription? How do I cancel?', 'Is XpertRank an SEO service?', 'How is XpertRank different from an SEO agency?', 'Is there a money-back promise?', 'Can you guarantee first page on Google?', 'How long before I see results?', 'Can you look after a website built by someone else?']);
const extraLd = [{ '@type': 'Service', name: 'SEO services in Malaysia: XpertRank', serviceType: 'Search engine optimisation (SEO)', provider: { '@id': `${site.url}/#org` }, url: `${site.url}/seo-services-malaysia/`, areaServed: areaLd, description: 'XpertRank, our expert SEO service for websites built by SEOXpert: keyword tracking, on page and technical SEO, new blog posts every month, AI search (LLM) optimisation and a live XpertInsight dashboard, with high speed cloud hosting included.', offers: offersLd(care) }, pf.ld];
---
<Base title="SEO Services Malaysia: SEO Agency for Google and AI | SEOXpert" image={`/img/${pictures["seo-services-malaysia"].file}.jpg`} description={`SEO services in Malaysia: XpertRank from ${fmt(basic)} a month for websites we build, with a money-back promise, or ${fmtOther(basic)} for existing websites. Google and AI search SEO.`} path="/seo-services-malaysia/" crumb="SEO services" extraLd={extraLd}>
<main id="main">
<PageHero kicker="SEO services" brand="XpertRank" art="seo" crumb="SEO services" word="SEO">
  <Fragment slot="title">SEO services in Malaysia, <em>built into your website</em>.</Fragment>
  <Fragment slot="lede">XpertRank is our expert SEO service. We optimise your target keywords for Google and AI search (LLM), write new content every month and fix what holds you back. It starts from <Fragment set:html={px(basic)} /> a month for websites we build{rankNote()}, backed by our money-back promise, and from <Fragment set:html={px(basic, 'other')} /> a month for a website you already have. It is a subscription: cancel any time.</Fragment>
  <Fragment slot="cta"><a class="btn" href="#plans">See XpertRank plans</a><a class="btn ghost" href={whatsappLink}>{talkLabel}</a></Fragment>
</PageHero>

<section class="solid band"><div class="wrap">
  <span class="eyebrow rv">Everything Google and AI search look for, every month</span>
  <h2 class="rv">What do our SEO services include?</h2>
  <p class="sub rv">SEO (search engine optimisation, also spelled search engine optimization) is the work of helping Google and AI tools find, understand and show your website. With XpertRank, our SEO company in {site.country} does that work for you, for businesses in {areaText}.</p>
  <div class="grid3">
    <div class="fcard rv" style="--d:0"><div class="pet" style="--r:0deg"></div><h3>Target keywords, optimised and tracked</h3><p>We find the words your customers type, optimise your website for them on Google and AI search (LLM), and check your Google position for each one every week. {basic.kw} target keywords with {basic.name.replace('XpertRank ', '')}, up to {elite.kw} with {elite.name.replace('XpertRank ', '')}.</p></div>
    <div class="fcard rv" style="--d:1"><div class="pet" style="--r:90deg"></div><h3>On page SEO</h3><p>Titles, descriptions, headings and answer first copy, tuned for what people search. Every page has one clear topic.</p></div>
    <div class="fcard rv" style="--d:2"><div class="pet" style="--r:180deg"></div><h3>Technical SEO</h3><p>Fast pages, clean code and structured data: in place from day one on websites we build, and fixed from the weekly audit on websites built elsewhere. See our <a href="/website-development/">website development</a>.</p></div>
    <div class="fcard rv" style="--d:0"><div class="pet" style="--r:270deg"></div><h3>Highly rankable content</h3><p>New blog posts every month, from 1 on {basic.name.replace('XpertRank ', '')} to 8 on {elite.name.replace('XpertRank ', '')}, written with XpertCore and checked by our experts.</p></div>
    <div class="fcard rv" style="--d:1"><div class="pet" style="--r:45deg"></div><h3>AI search (LLM) optimisation</h3><p>Each month we ask ChatGPT, Gemini, Perplexity and Google's AI answers the questions your customers ask, and improve your pages so they can be quoted. Read about <a href="/blog/ai-seo-malaysia/">AI SEO in Malaysia</a>.</p></div>
    <div class="fcard rv" style="--d:2"><div class="pet" style="--r:135deg"></div><h3>Active checks and fixes</h3><p>We check your website every few days, fix what we find, and make SEO and AI search optimisations when they are needed.</p></div>
  </div>
</div></section>

<section class="solid tint band"><div class="wrap split">
  <div class="stick">
    <span class="eyebrow rv">How it works</span>
    <h2 class="rv">Our SEO services, week by week.</h2>
    <p class="sub rv">You always see what we did and what changed, in plain words.</p>
  </div>
  <ol class="nsteps">
    <li class="rv"><h3>Every few days</h3><p>We actively check your website, fix what we find and keep it fast and safe, as part of our <a href="/website-maintenance/">website maintenance service</a>. Websites we build stay online on our high speed cloud hosting.</p></li>
    <li class="rv" style="--d:1"><h3>Every week</h3><p>XpertCore rank tracking checks where each of your keywords sits in Google's top 100, and the XpertCore site audit checks your pages. On Plus and up we also <a href="/blog/seo-competitor-analysis/">track your competitors</a>.</p></li>
    <li class="rv" style="--d:2"><h3>Every month</h3><p>New blog posts and page changes go live, we check what AI tools say about your business, and we check your backlinks (every week on Pro and Elite).</p></li>
    <li class="rv" style="--d:3"><h3>Any time</h3><p>Your <a href="/website-report-dashboard/">XpertInsight dashboard</a> shows visitors, leads, Google search data, speed and uptime, refreshed every day, plus keywords, AI answers and site health, with a monthly XpertRecap PDF.</p></li>
  </ol>
</div></section>

<section class="dark band"><div class="wrap pmgrid">
  <div>
    <span class="eyebrow rv">Our money-back promise</span>
    <p class="creed rv">{promise.replace(", we refund that month of XpertRank in full.", ",")} <em>we refund that month of XpertRank in full</em>.</p>
    <p class="pmwho rv">For every paid XpertRank plan on a website we build. Not for websites built elsewhere, and not the Trial.</p>
    <p class="pmhow rv"><b>How we check it:</b> every week XpertCore rank tracking looks up your tracked keywords on Google. The moving example shows one keyword climbing into the top 50 in its first month.</p>
  </div>
  <!-- "Rank Guard" (Suhen picked it 2026-11-16, in the site's own look): a purple force-field shield guarding a stack of
       Google results, where an example keyword climbs into the top 50 (public/js/promise3d.js, three.js on demand).
       The caption under it follows the example; it is never a result. A picture of the same scene shows until it loads. -->
  <div class="pmstage">
    <div class="pm3d" id="pm3d" role="img" aria-label="Example of how we check it: a tracked keyword climbs Google week by week in its first month, from position 88 to 43, inside the top 50, and our money-back shield lights up gold."><div class="pmfall"><img src="/img/rank-guard-360.webp" srcset="/img/rank-guard-360.webp 360w, /img/rank-guard.webp 720w" sizes="(max-width:900px) 300px, 440px" width="720" height="720" alt="" loading="lazy" decoding="async" /></div></div>
    <p class="pmcap" data-pm-cap aria-hidden="true"><span class="pmcx">Example</span><span class="pmcw"><b data-pm-week>Week 4</b> &middot; position <b data-pm-pos>43</b></span><span class="pmcok">Inside Google's top 50 in the first month</span></p>
  </div>
</div></section>

<section id="plans" class="solid band"><div class="wrap">
  <span class="eyebrow rv">XpertRank plans</span>
  <h2 class="rv">How much do SEO services cost in Malaysia?</h2>
  <p class="sub rv">Four plan sizes: Essential, Growth, Competitive and Market-leading SEO. Every plan includes your XpertInsight dashboard and the monthly XpertRecap PDF. Websites we build with XpertForge also get free high speed cloud hosting, so the same team looks after the code, the content and the hosting. See the <a href="/packages/">web design and SEO packages</a>.</p>
  <Packages show="care" pickHref="/packages/#plan" />
</div></section>

<section class="solid tint band"><div class="wrap split">
  <div class="stick">
    <span class="eyebrow rv">Why SEO starts with the website</span>
    <h2 class="rv">An SEO agency that builds the website too.</h2>
  </div>
  <div class="prose">
    <p class="rv">Many SEO agencies are handed a website someone else built, and then work around its limits. We do it the other way round. Every XpertForge website is planned for Google and AI search before it is designed, and XpertRank keeps that work going every month.</p>
    <p class="rv">When we built and host your website, we can change anything that holds it back: the words, the code, the speed or the structure. There is no waiting for another developer.</p>
    <p class="rv">Already have a website? XpertRank works on it too, at its own price. Or start fresh with <a href="/website-design/">website design</a>{offerOn() ? ', and every new website gets free months of XpertRank during the launch offer' : ''}.</p>
    <p class="rv">See real numbers in our <a href="/case-studies/">SEO case studies</a>, taken straight from Google.</p>
    <p class="rv">Want to learn the basics first? Read our <a href="/blog/seo-malaysia-guide/">guide to SEO in Malaysia</a> and our guide to <a href="/blog/local-seo-malaysia/">local SEO in Malaysia</a>.</p>
  </div>
</div></section>
<section class="solid band"><div class="wrap split">
  <div class="stick">
    <span class="eyebrow rv">Your SEO expert in Malaysia</span>
    <h2 class="rv">An SEO expert and consultant, not a call centre.</h2>
  </div>
  <div class="prose">
    <p class="rv">SEOXpert is founder led. Your SEO is planned and overseen by our founder, after more than 7 years of hands-on SEO, with no outsourcing and no white labelling. You talk to the person who does the work.</p>
    <p class="rv">Like a good SEO consultant, we start with research: the <a href="/blog/keyword-research-seo-malaysia/">keywords your customers type</a>, how hard each one is, and which ones your website can realistically win. We do it with XpertForesight, the <a href="/seo-tools/">SEO research tool</a> we built ourselves. Then, unlike most consultants, we do the work ourselves, every month, and show it in your <a href="/website-report-dashboard/">XpertInsight dashboard</a>.</p>
    <p class="rv">We use white hat methods only, and we never promise rankings. The one promise we make is our money-back promise, in the exact words above.</p>
  </div>
</div></section>

<section class="solid tint band"><div class="wrap">
  <span class="eyebrow rv">SEO in Kuala Lumpur and Selangor</span>
  <h2 class="rv">SEO services for Kuala Lumpur, Selangor and Petaling Jaya.</h2>
  <p class="sub rv">We are based in {site.country} and work with businesses in {areaText}. Local searches like "near me" depend on your Google Business Profile as much as your website, so every XpertForge build sets it up for you. Read our guide to <a href="/blog/local-seo-malaysia/">local SEO in Malaysia</a>.</p>
  <div class="grid3">
    <a class="fcard rv" href="/ai-seo-services-malaysia/" style="--d:0;text-decoration:none;color:inherit"><div class="pet" style="--r:0deg"></div><h3>AI SEO services</h3><p>Get named in ChatGPT, Gemini, Perplexity and Google AI answers, checked every month.</p><span class="more">AI SEO services</span></a>
    <a class="fcard rv" href="/seo-packages-malaysia/" style="--d:1;text-decoration:none;color:inherit"><div class="pet" style="--r:90deg"></div><h3>SEO packages</h3><p>Four XpertRank SEO packages, with the monthly price on every one.</p><span class="more">Compare SEO packages</span></a>
    <a class="fcard rv" href="/seo-audit-malaysia/" style="--d:2;text-decoration:none;color:inherit"><div class="pet" style="--r:180deg"></div><h3>SEO audit</h3><p>A technical SEO audit of your website every week, with fixes by our team.</p><span class="more">See the SEO audit</span></a>
  </div>
</div></section>
<Suite here="rank" title="Done for you or do it yourself: which SEO fits you?" eyebrow="Two ways to do SEO with us" intro="With XpertRank, our team does your SEO for you. With XpertForesight, you do your own SEO research with our SEO tools. Need a new website first? That is XpertForge." />
<Glance page="seo-services-malaysia" guides={['seo-malaysia-guide', 'keyword-research-seo-malaysia', 'seo-competitor-analysis']} />
<PageFaq title="SEO services questions, answered." items={pf.items} tint />
<Related skip="/seo-services-malaysia/" />
<Cta title="Ready to grow on Google and AI search?" />
</main>
<script slot="scripts" src="/js/packages.js" defer></script>
<script slot="scripts" src="/js/pay.js" defer></script>
<script slot="scripts" src="/js/promise3d.js" defer></script>
</Base>
