---
import Base from '../../layouts/Base.astro';
import Cta from '../../components/Cta.astro';
import BlogArt from '../../components/BlogArt.astro';
import '../../styles/page.css';
import '../../styles/blog.css';
import { site } from '../../config';
import { posts, postUrl, niceDate, type Post } from '../../data/blog';
export function getStaticPaths() { return posts.map((post) => ({ params: { slug: post.slug }, props: { post } })); }
const { post } = Astro.props as { post: Post };
const url = site.url + postUrl(post);
const strip = (t: string) => t.replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim();
const pic = `/img/guide-${post.slug}`;
const picAlt = `${post.h1} A summary of this guide in ${Math.min(post.sections.length, 6)} points: ${post.sections.slice(0, 6).map((x) => x.h.replace(/^\d+\.\s*/, '')).join('; ')}.`;
const others = posts.filter((p) => p.slug !== post.slug).slice(0, 3);
const extraLd = [
  { '@type': 'BlogPosting', headline: post.h1, description: post.description, url, mainEntityOfPage: url, datePublished: post.date, dateModified: post.date, inLanguage: 'en', author: { '@id': `${site.url}/#org` }, publisher: { '@id': `${site.url}/#org` }, image: { '@type': 'ImageObject', url: `${site.url}${pic}.jpg`, width: 1200, height: 630 } },
  { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: site.url + '/' }, { '@type': 'ListItem', position: 2, name: 'XpertAdvice', item: site.url + '/blog/' }, { '@type': 'ListItem', position: 3, name: post.h1, item: url }] },
  { '@type': 'FAQPage', mainEntity: post.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: strip(f.a) } })) },
];
---
<Base title={post.title} description={post.description} path={postUrl(post)} extraLd={extraLd} image={`${pic}.jpg`}>
<main id="main">
<article>
<header class="bhead band"><div class="wrap">
  <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/blog/">XpertAdvice</a><span aria-hidden="true">/</span><span aria-current="page">{post.tag}</span></nav>
  <div class="bmeta"><span class="btag">{post.tag}</span><time class="bdate" datetime={post.date}>{niceDate(post.date)}</time><span class="bdate">By SEOXpert</span></div>
  <h1>{post.h1}</h1>
  <div class="bshort"><b>Short answer</b><p>{post.short}</p></div>
</div></header>

<section class="solid band"><div class="wrap bart">
  <div class="bbody">
    <figure class="pfig bfig"><img src={`${pic}.webp`} srcset={`${pic}-640.webp 640w, ${pic}.webp 1200w`} sizes="(max-width: 980px) 100vw, 700px" width="1200" height="630" alt={picAlt} decoding="async"></figure>
    {post.sections.map((s) => <section><h2 id={s.id}>{s.h}</h2><Fragment set:html={s.html} /></section>)}
    <section><h2 id="questions">Questions people ask</h2>
      <div class="bfaq">{post.faqs.map((f) => <details><summary>{f.q}</summary><p set:html={f.a} /></details>)}</div>
    </section>
  </div>
  <aside class="baside">
    <nav class="bbox toc" aria-label="In this guide"><b>In this guide</b><ol>{post.sections.map((s) => <li><a href={`#${s.id}`}>{s.h}</a></li>)}<li><a href="#questions">Questions people ask</a></li></ol></nav>
    <div class="bbox dk"><span class="xp lt">{post.cta.pill}</span><h3>{post.cta.title}</h3><a class="btn" href={post.cta.href}>{post.cta.label}</a></div>
  </aside>
</div></section>
</article>

<section class="solid tint band"><div class="wrap">
  <span class="eyebrow rv">More guides</span>
  <h2 class="rv">Keep reading.</h2>
  <div class="bgrid">
    {others.map((p, i) => <a class="bcard rv" style={`--d:${i}`} href={postUrl(p)}><BlogArt kind={p.art} /><div class="cb"><span class="btag">{p.tag}</span><h3>{p.h1}</h3><p>{p.card}</p><span class="bmore">Read the guide</span></div></a>)}
  </div>
</div></section>
<Cta />
</main>
</Base>
