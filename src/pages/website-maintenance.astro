---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Cta from '../components/Cta.astro';
import Related from '../components/Related.astro';
import '../styles/page.css';
import Packages from '../components/Packages.astro';
import { site, whatsappLink, talkLabel } from '../config';
import { care, offersLd } from '../data/packages';
const extraLd = [{ '@type': 'Service', name: 'Website maintenance', serviceType: 'Monthly website maintenance', provider: { '@id': `${site.url}/#org` }, url: `${site.url}/website-maintenance/`, description: 'Monthly website maintenance: updates, backups, fixes and new content, so your website stays healthy and keeps growing.', offers: offersLd(care) }];
---
<Base title="Website Maintenance and Monthly Care | SEOXpert" description="Monthly website maintenance from SEOXpert. We keep your website updated, backed up and growing with new content, so you can get on with running your business." path="/website-maintenance/" crumb="Website maintenance" extraLd={extraLd}>
<main id="main">
<PageHero kicker="Monthly care" crumb="Website maintenance">
  <Fragment slot="title">Website maintenance, <em>month after month</em>.</Fragment>
  <Fragment slot="lede">A website is not finished on launch day. We keep yours updated, backed up and growing, so you can get on with running your business.</Fragment>
  <Fragment slot="cta"><a class="btn" href={whatsappLink}>{talkLabel}</a><a class="btn ghost" href="#xpertcare">See XpertCare plans</a></Fragment>
</PageHero>

<section id="what" class="solid band"><div class="wrap">
  <span class="eyebrow rv">What is website maintenance?</span>
  <h2 class="rv">The regular work that keeps a website healthy.</h2>
  <p class="sub rv">Website maintenance means keeping your website up to date, safe and useful after it goes live. With monthly care, that work is done for you.</p>
  <div class="grid3">
    <div class="fcard rv" style="--d:0"><div class="pet" style="--r:0deg"></div><h3>Updates</h3><p>Your website is kept up to date, so it keeps working the way it should.</p></div>
    <div class="fcard rv" style="--d:1"><div class="pet" style="--r:90deg"></div><h3>Backups</h3><p>Regular copies of your website are saved, so nothing is lost if something goes wrong.</p></div>
    <div class="fcard rv" style="--d:2"><div class="pet" style="--r:180deg"></div><h3>Fixes</h3><p>When something breaks or looks off, we put it right.</p></div>
    <div class="fcard rv" style="--d:0"><div class="pet" style="--r:270deg"></div><h3>New content</h3><p>Fresh pages and answers, so your website keeps growing instead of standing still, built the same way as our <a href="/website-design/">website design</a>.</p></div>
    <div class="fcard rv" style="--d:1"><div class="pet" style="--r:45deg"></div><h3>Search health</h3><p>We watch how your pages do on Google and AI search and adjust what needs adjusting.</p></div>
    <div class="fcard rv" style="--d:2"><div class="pet" style="--r:135deg"></div><h3>Clear reporting</h3><p>Visual reports from real data, so you always know where you stand and what we are working on.</p></div>
  </div>
</div></section>

<section id="xpertcare" class="solid band"><div class="wrap">
  <span class="eyebrow rv">XpertCare plans</span>
  <h2 class="rv">Website maintenance cost, month by month.</h2>
  <p class="sub rv">XpertCare is our monthly care plan. Pick the size that fits how often your website changes. Hosting is included with every plan, and you can add a plan to any of our <a href="/packages/">website design packages</a>. More answers are on the <a href="/faq/">questions page</a>.</p>
  <Packages show="care" pickHref="/packages/#plan" />
</div></section>

<section class="dark band"><div class="wrap">
  <span class="eyebrow rv">Why it matters</span>
  <p class="creed rv">Search visibility <em>builds over time</em>. A website that is looked after keeps its gains instead of losing them.</p>
</div></section>
<Related skip="/website-maintenance/" />
<Cta title="Let us look after your website." />
</main>
<script slot="scripts" src="/js/packages.js" defer></script>
</Base>
