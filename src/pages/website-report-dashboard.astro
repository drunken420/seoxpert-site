---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Cta from '../components/Cta.astro';
import Related from '../components/Related.astro';
import Glance from '../components/Glance.astro';
import PageFaq from '../components/PageFaq.astro';
import { pageFaq } from '../lib/faq';
import InsightDemo from '../components/InsightDemo.astro';
import { care } from '../data/packages';
import '../styles/page.css';
import '../styles/insight.css';
import { site, whatsappLink, talkLabel } from '../config';
// XpertInsight is included with every XpertRank plan and is not sold on its own (Suhen, 2026-11-12).
const kw = care.tiers.map((t) => [t.name, t.rows.join(' ').match(/<b>(\d+)<\/b> (?:target )?keywords/)?.[1]]);
const views = [
  ['overview', 'Overview', 'Your Xpert score out of 100, made from visits, leads, rankings, AI mentions and site health, plus insights from our experts in plain words.'],
  ['visitors', 'Visitors', 'Visits by day compared with the period before, where they came from, phone or computer, and your top pages on Google.'],
  ['leads', 'Leads', 'WhatsApp clicks, form messages and call clicks, week by week, and the pages that bring them.'],
  ['keywords', 'Keywords', 'Your tracked keywords checked every week, the ones almost on page 1, and how you compare with competitors.'],
  ['ai-answers', 'AI answers', 'Whether ChatGPT, Gemini, Perplexity and Google AI Overviews name your business, and the visits AI tools send you.'],
  ['health', 'Site health', 'A weekly technical SEO audit of your pages, with errors, warnings and what our team fixed, plus speed on phones, uptime, your security certificate and domain renewal dates.'],
  ['xpertrank', 'XpertRank', 'Your XpertRank SEO service this month: what your plan includes, the SEO and AI search work our team has done, and what comes next.'],
  ['reports', 'Reports', 'Your monthly XpertRecap PDF, with past months kept in one place.'],
  ['plan', 'Your plan', 'What your XpertRank plan includes, how much of it you use, and how it compares with the other plans.'],
];
const vmap = Object.fromEntries(views.map(([f, h, p]) => [f, [h, p]]));
const groups = [
  ['Visits and leads', 'See how many people find your website, and how many of them get in touch.', ['overview', 'visitors', 'leads']],
  ['Google and AI search', 'See where you show up on Google, and whether AI tools name your business.', ['keywords', 'ai-answers']],
  ['Health and SEO work', 'See that your website is healthy, the SEO work our team did this month, your reports and your plan.', ['health', 'xpertrank', 'reports', 'plan']],
];
// One tab per view, in group order; each tab knows its group name.
const tabs = groups.flatMap(([g, , fs]) => (fs as string[]).map((f) => ({ f, h: vmap[f][0], p: vmap[f][1], g: g as string })));
const extraLd = [{ '@type': 'Service', name: 'XpertInsight website report dashboard', serviceType: 'Website reporting', provider: { '@id': `${site.url}/#org` }, url: `${site.url}/website-report-dashboard/`, description: 'XpertInsight is the live website report dashboard included with every XpertRank plan: visitors, leads, keywords, AI answers and site health, plus a monthly XpertRecap PDF.' }];
const pf = pageFaq(['What is XpertInsight?', 'Does XpertInsight cost extra?', 'How do I log in to XpertInsight?', 'Can I check XpertInsight on my phone?', 'What is XpertRecap?']);
---
<Base title="Website Report Dashboard: XpertInsight | SEOXpert" image="/img/xpertinsight-share-3.jpg" description="XpertInsight is the live website report dashboard included with XpertRank: visitors, leads, keywords, AI answers and site health, plus a monthly PDF." path="/website-report-dashboard/" crumb="Website report dashboard" extraLd={[...extraLd, pf.ld]}>
<main id="main">
<PageHero kicker="Website report dashboard" brand="XpertInsight" art="insight" crumb="Website report dashboard" word="Insight">
  <Fragment slot="title">See how your website is doing, <em>any time</em>.</Fragment>
  <Fragment slot="lede">XpertInsight is our own live website report dashboard, included with every XpertRank plan. Log in to see your visitors, leads, keywords, AI answers and site health in plain words, and download your monthly XpertRecap as a PDF.</Fragment>
  <Fragment slot="cta"><a class="btn" href="#inside">Look inside</a><a class="btn ghost" href="/website-maintenance/#xpertrank">See XpertRank plans</a></Fragment>
</PageHero>

<section id="inside" class="solid band xiinsb"><i class="xiorb2 a" aria-hidden="true"></i><i class="xiorb2 b" aria-hidden="true"></i><div class="wrap">
  <span class="eyebrow rv">Inside XpertInsight</span>
  <h2 class="rv">Your website's numbers, in <span class="xigt">one clear place</span>.</h2>
  <p class="sub rv">Pick a view to look inside. Yours shows your own website.</p>
  <InsightDemo />
</div></section>

<section class="solid tint band xivital"><div class="wrap">
  <div class="xivtop">
    <div>
      <span class="eyebrow rv">All your vital info</span>
      <h2 class="rv">Every vital sign of your website, in one place.</h2>
      <p class="sub rv">Most reports stop at visitors. XpertInsight also watches the things that quietly take a website offline, like an expired domain name or SSL certificate, and reminds you before they run out.</p>
    </div>
    <div class="xivcard rv">
      <p class="xivhead">Sample Bakery <small>Dates we watch</small></p>
      <p class="xivrow"><i aria-hidden="true"></i><b>Domain name</b><span>Renews 14 Aug 2027</span><em>We remind you 30 days before</em></p>
      <p class="xivrow"><i aria-hidden="true"></i><b>SSL certificate</b><span>Renews 2 Jan 2027</span><em>We remind you 14 days before</em></p>
      <p class="xivnote">Live data, refreshed every day. Updates in the dashboard tell you when something changes.</p>
    </div>
  </div>
  <ul class="xivg">
    <li class="rv"><b>Uptime</b><span>Whether your website was online, day by day.</span></li>
    <li class="rv"><b>Speed</b><span>Google's own speed scores, on phone and computer.</span></li>
    <li class="rv"><b>Visitors</b><span>Who came to your website, and where from.</span></li>
    <li class="rv"><b>Leads</b><span>Who got in touch through your website.</span></li>
    <li class="rv"><b>Google searches</b><span>The words people searched before they clicked on you.</span></li>
    <li class="rv"><b>Keyword positions</b><span>Where you rank on Google, checked every week.</span></li>
    <li class="rv"><b>AI answers</b><span>Whether ChatGPT, Gemini, Perplexity and Google's AI mention you.</span></li>
    <li class="rv"><b>Site health</b><span>Problems found on your pages, and what our team fixed.</span></li>
  </ul>
</div></section>

<section class="dark band xitabb"><div class="wrap">
  <span class="eyebrow rv">Nine views, one login</span>
  <h2 class="rv">A closer look at every view.</h2>
  <p class="sub rv">Pick a view to see the real screen, just as it looks on a computer. <span class="xihint-ph">Swipe the screen to move to the next one.</span></p>
  <div class="xitabs" data-xitabs={JSON.stringify(tabs)}>
    <div class="xitablist" role="tablist" aria-label="XpertInsight views">
      {tabs.map(({ f, h, g }, i) => <button type="button" role="tab" id={`xit-${f}`} aria-controls="xitpanel" aria-selected={i ? 'false' : 'true'} tabindex={i ? -1 : 0} data-i={i} data-g={g}><span class="xitn">{String(i + 1).padStart(2, '0')}</span>{h}<i class="xitbar" aria-hidden="true"></i></button>)}
    </div>
    <div class="xitstage" id="xitpanel" role="tabpanel" aria-labelledby="xit-overview">
      <div class="xitinfo">
        <span class="xitg" data-xitg>{tabs[0].g}</span>
        <h3 data-xith>{tabs[0].h}</h3>
        <p data-xitp>{tabs[0].p}</p>
        <div class="xitnav"><button type="button" class="xitprev" aria-label="Previous view"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg></button><span class="xitcount"><b data-xitc>1</b> / {tabs.length}</span><button type="button" class="xitnext" aria-label="Next view"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></button></div>
      </div>
      <div class="xitwin">
        <div class="xiwbar" aria-hidden="true"><i></i><i></i><i></i><span>insight.seoxpert.my/<b data-xitu>{tabs[0].f}</b></span></div>
        <div class="xitshots">{tabs.map(({ f, h }, i) => <img class={i ? '' : 'on'} data-i={i} src={`/img/xi-screen-${f}.webp`} srcset={`/img/xi-screen-${f}-720.webp 720w, /img/xi-screen-${f}.webp 1200w`} sizes="(max-width: 1000px) 94vw, 760px" width="1200" height="750" loading={i ? 'lazy' : 'eager'} decoding="async" alt={`The ${h} view of XpertInsight on a computer`} />)}</div>
      </div>
    </div>
  </div>
</div></section>

<section class="solid band xiphb"><div class="wrap split">
  <div class="stick">
    <span class="eyebrow rv">On the go</span>
    <h2 class="rv">Made for phones too.</h2>
    <p class="sub rv">XpertInsight works on any phone, tablet or computer, so you can check how your website is doing from anywhere.</p>
    <ul class="xiticks">
      <li class="rv"><b>Pick a range</b>Choose this month, 7 days, 28 days or 3 months, and every chart and number follows.</li>
      <li class="rv" style="--d:1"><b>Secure login, no password</b>Get a fresh code to your email every time you log in. There is no password to remember.</li>
      <li class="rv" style="--d:2"><b>Download PDF</b>Save your monthly XpertRecap from your phone, ready to forward.</li>
    </ul>
  </div>
  <div class="xiph rv" data-xiph>
    <i class="xiorb"></i><i class="xiorb b"></i><i class="xiglow"></i>
    <div class="p1 xiphn" data-v="leads"><img src="/img/xi-phone-leads-28.webp" srcset="/img/xi-phone-leads-28-360.webp 360w, /img/xi-phone-leads-28.webp 640w" sizes="210px" width="640" height="1322" loading="lazy" decoding="async" alt="XpertInsight Leads view on a phone" /></div>
    <div class="p3 xiphn" data-v="health"><img src="/img/xi-phone-health-28.webp" srcset="/img/xi-phone-health-28-360.webp 360w, /img/xi-phone-health-28.webp 640w" sizes="210px" width="640" height="1322" loading="lazy" decoding="async" alt="XpertInsight Site health view on a phone" /></div>
    <div class="p2 xiphn" data-v="overview"><img src="/img/xi-phone-overview-28.webp" srcset="/img/xi-phone-overview-28-360.webp 360w, /img/xi-phone-overview-28.webp 640w" sizes="250px" width="640" height="1322" loading="lazy" decoding="async" alt="XpertInsight Overview with the Xpert score on a phone" /></div>
    <div class="xiseg" role="group" aria-label="Pick a range to see the phones change" data-r="28"><i></i><button type="button" data-r="7" aria-pressed="false">7 days</button><button type="button" data-r="28" aria-pressed="true">28 days</button><button type="button" data-r="90" aria-pressed="false">3 months</button></div>
    <span class="hchip xic1" aria-hidden="true">Code sent to your email</span>
    <span class="hchip plus xic2" aria-hidden="true">Download PDF</span>
  </div>
</div></section>

<section class="solid tint band"><div class="wrap">
  <span class="eyebrow rv">Handy extras</span>
  <h2 class="rv">Small tools that save you time.</h2>
  <p class="sub rv">Every XpertInsight account has these built in, on a computer or a phone.</p>
  <ul class="xivg">
    <li class="rv"><b>Refresh button</b><span>Fresh Google numbers when you want them, as often as your plan allows.</span></li>
    <li class="rv"><b>Updates</b><span>New keywords on Google, fixed problems, plan changes and reminders. A red number means something new.</span></li>
    <li class="rv"><b>Report button</b><span>Send our team a bug, an idea or a fix request from any page. We answer under Updates.</span></li>
    <li class="rv"><b>Since your last visit</b><span>What changed since you last looked, at the top of your Overview.</span></li>
    <li class="rv"><b>Run your own site audit</b><span>Check your pages again from Site health, as often as your plan allows.</span></li>
    <li class="rv"><b>Your plan</b><span>What your XpertRank plan includes, how much you use, and how it compares.</span></li>
    <li class="rv"><b>Guided tour</b><span>A one minute walk through every page, any time you press Tour.</span></li>
    <li class="rv"><b>This month</b><span>See this month so far next to 7 days, 28 days and 3 months.</span></li>
  </ul>
</div></section>

<section class="dark band"><div class="wrap split">
  <div>
    <span class="eyebrow rv">XpertRecap</span>
    <h2 class="rv">A monthly report you can save and share.</h2>
    <p class="sub rv">One tap on Download PDF saves the month as an XpertRecap: six pages covering the overview, visitors, leads, keywords, AI answers with site health, and your XpertRank work. It is easy to forward to a partner or keep with your records.</p>
    <p class="rv"><a class="btn" href="/xpertrecap.pdf" target="_blank" rel="noopener">See what an XpertRecap looks like (PDF)</a></p>
  </div>
  <ul class="xisrc">
    <li class="rv"><b>Updated every day</b>Your visitors, leads, Google search data, speed checks and uptime are read every morning. Keyword positions and the site audit are checked every week.</li>
    <li class="rv" style="--d:1"><b>Worked on by our team</b>Your target keywords are optimised for Google and AI search and tracked every week, and each month we ask AI tools the questions your customers ask.</li>
    <li class="rv" style="--d:2"><b>Private to you</b>A secure login with a fresh code sent to your email each time, and you only ever see your own website.</li>
    <li class="rv" style="--d:3"><b>Explained in plain words</b>Insights from our experts say what changed, what it means and what we will do next.</li>
  </ul>
</div></section>

<section class="solid band xiincb"><div class="wrap split xiinc">
  <div>
    <span class="eyebrow rv">Included with XpertRank</span>
    <h2 class="rv">No extra fee. It comes with your XpertRank plan.</h2>
    <p class="sub rv">XpertInsight is our own tool, built in house, and it is included with every <a href="/website-maintenance/">XpertRank</a> plan. It is not sold on its own. The bigger your plan, the more keywords it tracks: {kw.map(([n, k], i) => <>{i ? (i === kw.length - 1 ? ' and ' : ', ') : ''}{k} with {n}</>)}. Numbers on your dashboard come from your website's real data, and we never promise rankings: we show you honestly where you stand and what we are doing about it.</p>
    <p class="rv"><a class="btn" href="/website-maintenance/#xpertrank">Compare XpertRank plans</a></p>
  </div>
  <div class="xiplans">
    {kw.map(([n, k], i) => <details class="xiplan rv" name="xiplan" style={`--d:${i};--w:${Math.round(Number(k) / Number(kw[kw.length - 1][1]) * 100)}%`}>
      <summary>
        <div class="xiph1"><b>{n}</b></div>
        <div class="xikw"><strong data-count={k}>{k}</strong><small>target keywords we optimise and track</small></div>
        <div class="xikwbar"><i></i></div>
        <ul><li>XpertInsight dashboard</li><li>Monthly XpertRecap PDF</li></ul>
        <span class="xiopen">See everything included</span>
      </summary>
      <div class="xiall">
        <ul>{care.tiers[i].rows.map((r) => <li set:html={r} />)}{care.all.map((a) => <li>{a}</li>)}</ul>
        <a class="xicmp" href="/website-maintenance/#xpertrank">Compare all XpertRank plans and prices</a>
      </div>
    </details>)}
  </div>
</div></section>

<Glance page="website-report-dashboard" guides={['website-maintenance-malaysia', 'ai-seo-malaysia']} tint />
<PageFaq title="XpertInsight questions, answered." items={pf.items} />
<Related skip="/website-report-dashboard/" />
<Cta title="Want XpertInsight for your website?" />
</main>
<script slot="scripts" src="/js/insight.js" defer></script>
</Base>
