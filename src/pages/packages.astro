---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Cta from '../components/Cta.astro';
import Related from '../components/Related.astro';
import Glance from '../components/Glance.astro';
import PageFaq from '../components/PageFaq.astro';
import { pageFaq } from '../lib/faq';
import pictures from '../data/pictures.json';
import '../styles/page.css';
import Packages from '../components/Packages.astro';
import PlanPicker from '../components/PlanPicker.astro';
import { site } from '../config';
import { build, care, offersLd, fmt, fmtOther, px, offerOn } from '../data/packages';
// A real table of the three builds (2026-11-18 SEO review: the "at a glance" version was only a picture, which Google and AI tools cannot read)
const bshort = (n: string) => n.replace('XpertForge ', '');
const num = (row: string) => (String(row || '').match(/[0-9]+/) || [''])[0];
const brows: [string, (t: any) => string][] = [['Price', (t) => px(t)], ['Pages in total', (t) => num(t.rows[0])], ['At launch', (t) => t.rows[1].replace(/<[^>]+>/g, '').replace(/ at launch$/, '')], ['Revision rounds', (t) => num(t.rows[2])], ...(offerOn() ? [['Launch offer', (t: any) => t.free || '']] as [string, (t: any) => string][] : [])];
const extraLd = [
  { '@type': 'Service', name: 'Website design packages', serviceType: 'Website design', provider: { '@id': `${site.url}/#org` }, url: `${site.url}/packages/`, offers: offersLd(build) },
  { '@type': 'Service', name: 'XpertRank monthly website maintenance', serviceType: 'Website maintenance', provider: { '@id': `${site.url}/#org` }, url: `${site.url}/website-maintenance/`, offers: offersLd(care) },
];
const pf = pageFaq(['What is the difference between Starter, Business and Growth?', 'Is the website price paid once or every month?', 'Is there a launch offer?', 'Is there a discount if I pay yearly?', 'Is there a money-back promise?', 'What is the difference between the XpertRank plans?', 'Can I try XpertRank first?']);
---
<Base title="Website Design Packages and Prices in Malaysia | SEOXpert" image={`/img/${pictures["packages"].file}.jpg`} description={`Website design packages in Malaysia from ${fmt(build.tiers[0])}, with copywriting and keyword research. XpertRank SEO from ${fmt(care.tiers[0])} a month for websites we build, ${fmtOther(care.tiers[0])} for others.`} path="/packages/" crumb="Packages" extraLd={[...extraLd, pf.ld]}>
<main id="main">
<PageHero kicker="Packages" brand="XpertForge" art="packages" crumb="Packages" word="Packages">
  <Fragment slot="title">Website design packages in Malaysia, <em>in plain language</em>.</Fragment>
  <Fragment slot="lede">How much does website design cost in Malaysia? From <span data-rm={fmt(build.tiers[0], 'RM')} data-usd={fmt(build.tiers[0], 'USD')}>{fmt(build.tiers[0])}</span>, one time, with the writing included. XpertRank, our expert SEO service, starts at <span data-rm={fmt(care.tiers[0], 'RM')} data-usd={fmt(care.tiers[0], 'USD')}>{fmt(care.tiers[0])}</span>.</Fragment>
  <Fragment slot="cta"><a class="btn" href="#prices">See the packages</a><a class="btn ghost" href="#plan" data-pk-planlink>Build your plan</a></Fragment>
</PageHero>

<section id="prices" class="solid band"><div class="wrap">
  <span class="eyebrow rv">Packages and prices</span>
  <h2 class="rv">Choose the size that fits your business.</h2>
  <p class="sub rv">XpertForge is our website build: one price, paid once. XpertRank is the optional plan to grow it every month, with free high speed cloud hosting for websites we build. Already have a website? XpertRank works on it too, at its own price. Every blog post and all SEO content is made with <span class="pkcore">XpertCore</span>, our AI core, and checked by experts.</p>
  <Packages pickHref="#plan" />
  <h3 class="rv" style="margin-top:34px">Website design packages compared</h3>
  <div class="cmpwrap rv">
    <table class="cmptab">
      <thead><tr><th scope="col">XpertForge</th>{build.tiers.map((t) => <th scope="col" class:list={[t.hot && "hot"]}>{bshort(t.name)}<small>{t.for}</small></th>)}</tr></thead>
      <tbody>{brows.map(([h, f]) => <tr><th scope="row">{h}</th>{build.tiers.map((t) => <td class:list={[t.hot && "hot"]}><b set:html={f(t)} /></td>)}</tr>)}</tbody>
    </table>
  </div>
</div></section>

<section id="plan" class="solid band" hidden><div class="wrap">
  <span class="eyebrow rv">Build your plan</span>
  <h2 class="rv">Pick a website and an SEO plan. See your total.</h2>
  <div class="pkbar rv"><div class="pkcur" hidden data-pk-curbar><span>Show prices in</span><div class="pkseg sm" role="group" aria-label="Currency" data-pk-cur><button type="button" aria-pressed="true" data-c="RM">RM</button><button type="button" aria-pressed="false" data-c="USD">USD</button></div></div></div>
  <PlanPicker />
</div></section>

<section id="included" class="solid tint band"><div class="wrap">
  <span class="eyebrow rv">How it works</span>
  <h2 class="rv">What you get with every website design package.</h2>
  <ul class="ticks rv">
    <li>Pages planned for search with <a href="/ai-seo-advisor/">XpertCore, our AI SEO advisor</a></li>
    <li>Highly rankable content included: answer first writing, checked by experts</li>
    <li>Full keyword research with XpertCore, before anything is designed</li>
    <li>A fast website that works well on phones</li>
    <li>Titles, descriptions and structured data for Google</li>
    <li>An AI ranking file for AI search tools</li>
    <li>A WhatsApp button and contact page, so customers can reach you</li>
    <li>Monthly <a href="/website-maintenance/">website maintenance</a> with XpertRank, if you want it</li>
  </ul>
  <p class="sub rv" style="margin-top:28px">Built with XpertForge, guided by XpertCore, grown by XpertRank. <a href="/website-maintenance/">See what website maintenance covers</a>, compare our <a href="/seo-packages-malaysia/">SEO packages</a>, or read more about <a href="/website-design/">website design</a> and <a href="/website-development/">website development</a>. Need a bigger website, an online shop, bookings, a web app or a dashboard? Those are quoted on their scope: see <a href="/web-app-development-malaysia/">web app and dashboard development</a> or <a href="/contact/">get a quote</a>.</p>
</div></section>
<Glance page="packages" guides={['website-design-packages-malaysia', 'website-design-price-malaysia']} />
<PageFaq title="Package and price questions, answered." items={pf.items} tint />
<Related skip="/packages/" />
<Cta title="Not sure which package fits? Ask us." />
</main>
<script slot="scripts" src="/js/packages.js" defer></script>
<script slot="scripts" src="/js/pay.js" defer></script>
<script slot="scripts" src="/js/promise3d.js" defer></script>
</Base>
