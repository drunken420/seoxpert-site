---
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/sora/wght.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../styles/site.css';
import logo from '../fragments/logo.svg?raw';
import { site, whatsappLink, talkLabel, emailLink, areaText, areaLd } from '../config';
import { faqs } from '../lib/faq';
const chatData = { whatsapp: site.whatsapp ? whatsappLink : '', email: emailLink, faqs: faqs.map((f) => ({ q: f.q, a: f.text, ready: f.ready })) };

interface Props { title: string; description?: string; path?: string; crumb?: string; extraLd?: object[]; noindex?: boolean; image?: string }
const { title, description = site.description, path = '/', crumb, extraLd = [], noindex = false, image = '/og.png' } = Astro.props;
// The last line of the footer is different on every page and carries that page's keyword (Suhen, 2026-11-11).
// A new page needs a line here; anything missing falls back to the website design line.
const footLines: Record<string, string> = {
  '/': `Website design in ${areaText}.`,
  '/website-design/': `Website design in ${site.country}, planned for Google and AI search.`,
  '/website-development/': `Website development in ${site.country}, coded for SEO and AI search.`,
  '/website-maintenance/': `Website maintenance in ${site.country} with XpertCare, month after month.`,
  '/ai-website-builder/': `XpertCore, our AI website builder with search built in.`,
  '/packages/': `Website design packages in ${site.country}, in plain language.`,
  '/demos/': `XpertLab: interactive website demos in 3D and animation.`,
  '/blog/': `Website design and SEO guides for businesses in ${site.country}.`,
  '/about/': `A web design company in ${site.country}, serving ${site.areas.slice(0, -1).join(', ')} and ${site.areas[site.areas.length - 1]}.`,
  '/faq/': `Website design questions and answers, in plain words.`,
  '/contact/': `Talk to us about website design in ${areaText}.`,
  '/blog/local-seo-malaysia/': `A plain guide to local SEO in ${site.country}.`,
  '/blog/website-design-kuala-lumpur-selangor/': `A guide to website design in Kuala Lumpur and Selangor.`,
  '/blog/website-design-packages-malaysia/': `A guide to choosing website design packages in ${site.country}.`,
  '/blog/website-design-price-malaysia/': `A guide to website design prices in ${site.country}.`,
  '/blog/seo-malaysia-guide/': `A plain guide to SEO in ${site.country}.`,
  '/blog/ai-seo-malaysia/': `A plain guide to AI SEO in ${site.country}.`,
  '/blog/website-maintenance-malaysia/': `A guide to website maintenance in ${site.country}.`,
  '/blog/choose-web-design-company-malaysia/': `A guide to choosing a web design company in ${site.country}.`,
};
const footLine = footLines[path] || footLines['/'];
// The Services dropdown in the top menu (desktop). The phone menu lists every page.
const svc = [['/website-design/', 'Website design', 'Planned for Google and AI search'], ['/website-development/', 'Website development', 'Coded to be found, with XpertForge'], ['/website-maintenance/', 'XpertCare', 'Website maintenance, month after month'], ['/ai-website-builder/', 'XpertCore', 'Our own AI website builder']];
const canonical = new URL(path, site.url).href;
const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Organization', '@id': `${site.url}/#org`, name: site.name, url: site.url, logo: `${site.url}/logo.svg`, slogan: site.tagline, description: site.description, areaServed: areaLd },
    { '@type': 'WebSite', '@id': `${site.url}/#website`, url: site.url, name: site.name, publisher: { '@id': `${site.url}/#org` }, inLanguage: 'en' },
    ...(crumb ? [{ '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: site.url + '/' }, { '@type': 'ListItem', position: 2, name: crumb, item: canonical }] }] : []),
    ...extraLd,
  ],
};
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<meta name="theme-color" content="#7b18c1">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<meta property="og:type" content="website">
<meta property="og:site_name" content={site.name}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={site.url + image}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
{noindex && <meta name="robots" content="noindex">}
<script type="application/ld+json" set:html={JSON.stringify(ld)}></script>
<slot name="head" />
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="site-head band"><i class="prog" aria-hidden="true"></i><div class="wrap"><a class="brand" href="/" aria-label="SEOXpert home" set:html={logo}></a>
<nav class="menu" aria-label="Main"><div class="mdrop"><button type="button" aria-expanded="false" aria-controls="mdrop" class={svc.some((l) => l[0] === path) ? 'cur' : undefined}>Services<svg viewBox="0 0 12 12" aria-hidden="true"><path d="m2.5 4.5 3.5 3.5 3.5-3.5"/></svg></button><div class="mpanel" id="mdrop">{svc.map((l) => <a href={l[0]} aria-current={path === l[0] ? 'page' : undefined}><b>{l[1]}</b><span>{l[2]}</span></a>)}</div></div><a href="/packages/" aria-current={path === '/packages/' ? 'page' : undefined}>Packages</a><a href="/demos/" aria-current={path === '/demos/' ? 'page' : undefined}>XpertLab</a><a href="/blog/" aria-current={path.startsWith('/blog/') ? 'page' : undefined}>Blog</a><a href="/about/" aria-current={path === '/about/' ? 'page' : undefined}>About</a></nav>
<a class="btn sm" href={whatsappLink}>{talkLabel}</a>
<button class="burger" type="button" aria-label="Menu" aria-expanded="false" aria-controls="mmenu"><i></i><i></i><i></i></button></div>
<nav class="mmenu" id="mmenu" aria-label="Main, phone" hidden><a href="/website-design/" aria-current={path === '/website-design/' ? 'page' : undefined}>Website design</a><a href="/website-development/" aria-current={path === '/website-development/' ? 'page' : undefined}>Website development</a><a href="/website-maintenance/" aria-current={path === '/website-maintenance/' ? 'page' : undefined}>XpertCare</a><a href="/ai-website-builder/" aria-current={path === '/ai-website-builder/' ? 'page' : undefined}>XpertCore</a><a href="/packages/" aria-current={path === '/packages/' ? 'page' : undefined}>Packages</a><a href="/demos/" aria-current={path === '/demos/' ? 'page' : undefined}>XpertLab</a><a href="/blog/" aria-current={path.startsWith('/blog/') ? 'page' : undefined}>Blog</a><a href="/about/" aria-current={path === '/about/' ? 'page' : undefined}>About</a><a href="/faq/" aria-current={path === '/faq/' ? 'page' : undefined}>FAQ</a><a href="/contact/" aria-current={path === '/contact/' ? 'page' : undefined}>Contact</a></nav></header>
<slot />
<footer class="foot band"><div class="wrap">
  <div class="fbrand"><a class="brand" href="/" aria-label="SEOXpert home" set:html={logo}></a><p>{site.tagline}.</p><a class="btn sm" href={whatsappLink}>{talkLabel}</a></div>
  <nav aria-label="Services"><b>What we do</b><a href="/website-design/" aria-current={path === '/website-design/' ? 'page' : undefined}>Website design</a><a href="/website-development/" aria-current={path === '/website-development/' ? 'page' : undefined}>Website development</a><a href="/website-maintenance/" aria-current={path === '/website-maintenance/' ? 'page' : undefined}>Website maintenance</a><a href="/ai-website-builder/" aria-current={path === '/ai-website-builder/' ? 'page' : undefined}>AI website builder</a><a href="/packages/" aria-current={path === '/packages/' ? 'page' : undefined}>Website design packages</a><a href="/demos/" aria-current={path === '/demos/' ? 'page' : undefined}>Interactive website demos</a></nav>
  <nav aria-label="Company"><b>SEOXpert</b><a href="/about/" aria-current={path === '/about/' ? 'page' : undefined}>About our web design company</a><a href="/blog/" aria-current={path.startsWith('/blog/') ? 'page' : undefined}>Website design and SEO guides</a><a href="/faq/" aria-current={path === '/faq/' ? 'page' : undefined}>Website design questions</a><a href="/contact/" aria-current={path === '/contact/' ? 'page' : undefined}>Contact</a></nav>
</div><div class="wrap fbar"><span>&copy; {new Date().getFullYear()} SEOXpert. {footLine}</span><a href="#">Back to top</a></div></footer>
<button class="chatfab" type="button" data-chat-open aria-label="Open chat" aria-controls="chatpanel" aria-expanded="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12Z"/><path d="M9 11h6M9 14h4"/></svg></button>
<div class="chatpanel" id="chatpanel" role="dialog" aria-label="Chat with SEOXpert" hidden>
  <div class="cp-head"><span class="spark" aria-hidden="true"></span><div>SEOXpert quick answers<small>Instant answers. A real person replies {site.whatsapp ? 'on WhatsApp or email' : 'by email'}.</small></div><button class="cp-x" type="button" aria-label="Close chat">&times;</button></div>
  <div class="cp-log" aria-live="polite"></div>
  <div class="cp-chips"></div>
  <form class="cp-form" autocomplete="off"><input type="text" maxlength="200" placeholder="Type your question" aria-label="Your question"><button type="submit">Send</button></form>
</div>
<script type="application/json" id="chatdata" set:html={JSON.stringify(chatData).replace(/</g, '\\u003c')}></script>
<script src="/js/ui.js" defer></script>
<slot name="scripts" />
</body>
</html>
